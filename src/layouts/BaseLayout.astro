---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { SITE_NAME } from '@/lib/site';
import '@/styles/global.css';

/**
 * Le test d'environnement est écrit ici, littéralement, plutôt qu'importé :
 * Vite remplace `import.meta.env.*` par sa valeur au build, ce qui rend la
 * branche morte évidente et fait disparaître l'import dynamique du bundle.
 * Avec un import statique, l'île de Visual Editing était émise dans la sortie
 * publique — 678 kB jamais servis, mais bien présents.
 */
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
const VisualEditing = visualEditingEnabled
  ? (await import('@sanity/astro/visual-editing')).VisualEditing
  : null;

interface Props {
  title: string;
  description?: string;
  titleOrder?: 'page-first' | 'site-first';
  pageClass?: string;
  headerVariant?: 'light' | 'transparent';
  footerVariant?: 'default' | 'compact';
  noIndex?: boolean;
  canonicalPath?: string;
  redirectTo?: string;
}

const {
  title,
  description = 'Site Web de la Paroisse Saint-René-Goupil.',
  titleOrder = 'page-first',
  pageClass,
  headerVariant = 'light',
  footerVariant = 'default',
  noIndex = false,
  canonicalPath,
  redirectTo,
} = Astro.props;
const documentTitle =
  title === SITE_NAME
    ? title
    : titleOrder === 'site-first'
      ? `${SITE_NAME} | ${title}`
      : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    {
      /* En prévisualisation, toutes les pages sont interdites d'indexation :
         elles montrent des brouillons, qui ne doivent jamais atterrir dans un
         moteur de recherche même si l'environnement fuit. */
      (noIndex || visualEditingEnabled) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    {canonicalPath && <link rel="canonical" href={canonicalPath} />}
    {
      redirectTo && (
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{documentTitle}</title>
  </head>
  <body
    class:list={['site-shell', 'has-mobile-actions', pageClass]}
    data-header-variant={headerVariant}
  >
    <a class="skip-link" href="#contenu-principal">Aller au contenu principal</a
    >
    <Header variant={headerVariant} />
    <main
      id="contenu-principal"
      class:list={{
        'site-main--light': headerVariant === 'light',
      }}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer variant={footerVariant} />
    {
      /* Overlays officiels de Sanity. Sans le drapeau, rien n'est rendu et
        aucun JavaScript de Visual Editing n'est envoyé au navigateur. */
    }
    {VisualEditing && <VisualEditing enabled />}
  </body>
</html>
