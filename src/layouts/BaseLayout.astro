---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { SITE_NAME } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  titleOrder?: 'page-first' | 'site-first';
  pageClass?: string;
  headerVariant?: 'light' | 'transparent';
  footerVariant?: 'default' | 'compact';
  noIndex?: boolean;
}

const {
  title,
  description = 'Site Web de la Paroisse Saint-René-Goupil.',
  titleOrder = 'page-first',
  pageClass,
  headerVariant = 'light',
  footerVariant = 'default',
  noIndex = false,
} = Astro.props;
const documentTitle =
  title === SITE_NAME
    ? title
    : titleOrder === 'site-first'
      ? `${SITE_NAME} | ${title}`
      : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{documentTitle}</title>
  </head>
  <body
    class:list={['site-shell', 'has-mobile-actions', pageClass]}
    data-header-variant={headerVariant}
  >
    <a class="skip-link" href="#contenu-principal">Aller au contenu principal</a
    >
    <Header variant={headerVariant} />
    <main
      id="contenu-principal"
      class:list={{
        'site-main--light': headerVariant === 'light',
      }}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer variant={footerVariant} />
  </body>
</html>
