---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { getSiteSettings } from '@/lib/content/getSiteSettings';
import { buildDocumentHead, type TitleOrder } from '@/lib/seo/documentHead';
import { SITE_URL } from '@/lib/seo/siteUrl';
import { SITE_NAME } from '@/lib/site';
import type { PageSeo } from '@/types/seo';
import '@/styles/global.css';

/**
 * Le test d'environnement est écrit ici, littéralement, plutôt qu'importé :
 * Vite remplace `import.meta.env.*` par sa valeur au build, ce qui rend la
 * branche morte évidente et fait disparaître l'import dynamique du bundle.
 * Avec un import statique, l'île de Visual Editing était émise dans la sortie
 * publique — 678 kB jamais servis, mais bien présents.
 */
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
const VisualEditing = visualEditingEnabled
  ? (await import('@sanity/astro/visual-editing')).VisualEditing
  : null;

interface Props {
  /**
   * Référencement de la page, en un seul objet.
   *
   * Les pages branchées sur Sanity passent le bloc que leur normalizer a
   * composé; les trois anciennes adresses, la page 404 et la page de
   * vérification l'écrivent à la main — elles n'ont pas de document.
   */
  seo: PageSeo;
  titleOrder?: TitleOrder;
  pageClass?: string;
  headerVariant?: 'light' | 'transparent';
  footerVariant?: 'default' | 'compact';
  redirectTo?: string;
}

const {
  seo,
  titleOrder = 'page-first',
  pageClass,
  headerVariant = 'light',
  footerVariant = 'default',
  redirectTo,
} = Astro.props;

// Image de partage générale, servie aux pages qui n'ont pas la leur. Le nom de
// la paroisse, lui, reste la constante locale : en prévisualisation, une
// chaîne venue de Sanity porte des caractères stega invisibles, et le titre
// d'un document n'est pas un endroit où les laisser entrer.
const siteSettings = await getSiteSettings();

const head = buildDocumentHead({
  seo,
  siteName: SITE_NAME,
  siteUrl: SITE_URL,
  pathname: Astro.url.pathname,
  siteShareImage: siteSettings.shareImage,
  titleOrder,
  previewing: visualEditingEnabled,
});
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={head.description} />
    {head.robots && <meta name="robots" content={head.robots} />}
    <link rel="canonical" href={head.canonicalUrl} />
    {
      redirectTo && (
        <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
      )
    }

    {/* Aperçu du lien quand la page est partagée. */}
    <meta property="og:type" content={head.openGraph.type} />
    <meta property="og:title" content={head.openGraph.title} />
    <meta property="og:description" content={head.openGraph.description} />
    <meta property="og:url" content={head.openGraph.url} />
    <meta property="og:site_name" content={head.openGraph.siteName} />
    <meta property="og:locale" content={head.openGraph.locale} />
    {
      head.openGraph.image && (
        <>
          <meta property="og:image" content={head.openGraph.image.url} />
          <meta property="og:image:alt" content={head.openGraph.image.alt} />
        </>
      )
    }
    {
      /* Les autres champs sont repris d'Open Graph : seule la forme de la
         vignette doit être dite. */
    }
    <meta name="twitter:card" content={head.twitterCard} />

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{head.title}</title>
  </head>
  <body
    class:list={['site-shell', 'has-mobile-actions', pageClass]}
    data-header-variant={headerVariant}
  >
    <a class="skip-link" href="#contenu-principal">Aller au contenu principal</a
    >
    <Header variant={headerVariant} />
    <main
      id="contenu-principal"
      class:list={{
        'site-main--light': headerVariant === 'light',
      }}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer variant={footerVariant} />
    {
      /* Overlays officiels de Sanity. Sans le drapeau, rien n'est rendu et
        aucun JavaScript de Visual Editing n'est envoyé au navigateur. */
    }
    {VisualEditing && <VisualEditing enabled />}
  </body>
</html>
