---
import Container from '@/components/ui/Container.astro';
import type { FirstVisitFaq as FirstVisitFaqContent } from '@/types/firstVisit';

interface Props {
  faq: FirstVisitFaqContent;
}

const { faq } = Astro.props;
---

{
  faq.items.length > 0 && (
    <section class="first-visit-faq" aria-labelledby="first-visit-faq-title">
      <Container size="narrow">
        <h2 id="first-visit-faq-title" class="first-visit-faq__title">
          {faq.title}
        </h2>

        <div class="first-visit-faq__list">
          {faq.items.map((item) => (
            <details class="first-visit-faq__item">
              <summary>
                <span>{item.question}</span>
                <svg
                  class="first-visit-faq__chevron"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19 9-7 7-7-7"
                  />
                </svg>
              </summary>
              <div class="first-visit-faq__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </Container>
    </section>
  )
}

<style>
  .first-visit-faq {
    padding-block: 5rem 7rem;
    background: var(--color-paper);
  }

  .first-visit-faq__title {
    margin: 0 0 2.5rem;
    color: var(--color-charcoal);
    font-size: clamp(2rem, calc(1.814rem + 0.762vw), 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }

  .first-visit-faq__list {
    display: grid;
    gap: 0.25rem;
  }

  .first-visit-faq__item {
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
  }

  .first-visit-faq__item summary {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-short) var(--ease-editorial);
  }

  .first-visit-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .first-visit-faq__item summary:hover {
    background: var(--color-paper);
  }

  .first-visit-faq__chevron {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    color: var(--color-gold);
    stroke-width: 2;
    transition: rotate var(--duration-normal) var(--ease-editorial);
  }

  .first-visit-faq__item[open] .first-visit-faq__chevron {
    rotate: 180deg;
  }

  .first-visit-faq__answer {
    padding: 1rem 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .first-visit-faq__answer p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .first-visit-faq__chevron {
      transition: none;
    }
  }
</style>
