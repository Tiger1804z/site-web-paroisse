---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import {
  formatParishEventDate,
  getParishEventCategoryLabel,
} from '@/lib/events/parish-events';
import type { ParishEventWithTemporalStatus } from '@/types/parish-events';

interface Props {
  title: string;
  events: readonly ParishEventWithTemporalStatus[];
}

const { title, events } = Astro.props;
---

<section
  class="past-events-section section-block"
  aria-labelledby="past-events-title"
>
  <Container>
    <header class="past-events-section__header" data-motion-reveal>
      <Eyebrow>Mémoire communautaire</Eyebrow>
      <h2 id="past-events-title" class="type-h2">{title}</h2>
    </header>

    <div class="past-events-section__grid">
      {
        events.map((event) => (
          <article
            id={event.slug}
            class:list={[
              'past-event',
              !event.coverImage && 'past-event--without-image',
            ]}
            data-motion-reveal
          >
            {event.coverImage && (
              <div class="past-event__media-column">
                <figure class="past-event__media">
                  <Image
                    src={event.coverImage.image}
                    alt={event.coverImage.alt}
                    widths={[480, 720]}
                    sizes="(min-width: 48rem) 42vw, calc(100vw - 2.5rem)"
                    loading="lazy"
                    decoding="async"
                  />
                  {event.coverImage.credit && (
                    <figcaption>Photo : {event.coverImage.credit}</figcaption>
                  )}
                </figure>
                {event.gallery && event.gallery.length > 0 && (
                  <div
                    class="past-event__gallery"
                    aria-label="Autres photographies de l’événement"
                  >
                    {event.gallery.map((galleryImage) => (
                      <figure class="past-event__gallery-item">
                        <Image
                          src={galleryImage.image}
                          alt={galleryImage.alt}
                          widths={[240, 400]}
                          sizes="(min-width: 48rem) 20vw, 50vw"
                          loading="lazy"
                          decoding="async"
                        />
                        {galleryImage.credit && (
                          <figcaption>Photo : {galleryImage.credit}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}
              </div>
            )}

            <div class="past-event__content">
              <p class="past-event__category">
                {getParishEventCategoryLabel(event.category)}
              </p>
              <p class="past-event__date">
                <time datetime={event.startAt}>
                  {formatParishEventDate(event.startAt)}
                </time>
              </p>
              <h3 class="type-h3">{event.title}</h3>
              <p class="past-event__excerpt">{event.excerpt}</p>
              {event.locationName && (
                <p class="past-event__location">
                  <span>Destination</span>
                  {event.locationName}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .past-events-section {
    overflow: clip;
    border-top: 1px solid var(--color-border);
    background: var(--color-paper);
    color: var(--color-charcoal);
  }

  .past-events-section__header {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .past-events-section__header h2 {
    margin: 0.9rem 0 0;
    color: var(--color-charcoal);
  }

  .past-events-section__grid {
    display: grid;
    gap: 1.5rem;
  }

  .past-event {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-ivory);
    box-shadow: 0 1.25rem 3.5rem rgb(28 25 24 / 7%);
  }

  .past-event__media {
    position: relative;
    min-height: 18rem;
    margin: 0;
    overflow: hidden;
  }

  .past-event__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .past-event__media figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.65rem;
    padding: 0.3rem 0.5rem;
    background: rgb(28 25 24 / 78%);
    color: var(--color-ivory);
    font-size: 0.6875rem;
  }

  .past-event__media-column {
    min-width: 0;
    background: var(--color-charcoal);
  }

  .past-event__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    padding-top: 2px;
    background: var(--color-gold);
  }

  .past-event__gallery-item {
    position: relative;
    height: 9rem;
    margin: 0;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .past-event__gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .past-event__gallery-item figcaption {
    position: absolute;
    right: 0.35rem;
    bottom: 0.35rem;
    max-width: calc(100% - 0.7rem);
    padding: 0.2rem 0.35rem;
    background: rgb(28 25 24 / 78%);
    color: var(--color-ivory);
    font-size: 0.5625rem;
    line-height: 1.3;
  }

  .past-event__content {
    padding: clamp(1.75rem, 5vw, 3rem);
  }

  .past-event__category {
    margin: 0;
    color: var(--color-burgundy);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .past-event__date {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .past-event h3 {
    margin: 0.5rem 0 0;
    color: var(--color-charcoal);
  }

  .past-event__excerpt {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .past-event__location {
    display: grid;
    gap: 0.25rem;
    margin: 1.5rem 0 0;
    color: var(--color-charcoal);
  }

  .past-event__location span {
    color: var(--color-gold);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .past-event--without-image {
    position: relative;
  }

  .past-event--without-image::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-gold);
    content: '';
  }

  @media (min-width: 48rem) {
    .past-event:not(.past-event--without-image) {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    }

    .past-event--without-image .past-event__content {
      max-width: 60rem;
    }
  }
</style>
