---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import type { EventsPageData } from '@/types/events';

interface Props {
  hero: EventsPageData['hero'];
}

const { hero } = Astro.props;
const heroStyle = `--events-hero-position: ${hero.image.position ?? 'center'}`;
---

<section
  class="events-hero"
  style={heroStyle}
  aria-labelledby="events-hero-title"
>
  <Image
    class="events-hero__image"
    src={hero.image.image}
    alt={hero.image.imageAlt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="events-hero__overlay" aria-hidden="true"></div>
  <Container class="events-hero__container">
    <div class="events-hero__content">
      <p class="events-hero__eyebrow type-eyebrow">{hero.eyebrow}</p>
      <h1 id="events-hero-title" class="events-hero__title type-h1">
        {hero.title}
      </h1>
      <p class="events-hero__introduction">{hero.introduction}</p>
    </div>
  </Container>
</section>

<style>
  .events-hero {
    position: relative;
    display: grid;
    height: 42svh;
    min-height: 21rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-charcoal);
  }

  .events-hero__image,
  .events-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .events-hero__image {
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--events-hero-position);
  }

  .events-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgb(28 25 24 / 78%) 0%,
        rgb(28 25 24 / 45%) 55%,
        rgb(28 25 24 / 28%) 100%
      ),
      linear-gradient(to top, rgb(28 25 24 / 72%), transparent 72%);
  }

  .events-hero__container {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .events-hero__content {
    max-width: 43rem;
  }

  .events-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-gold);
  }

  .events-hero__title {
    margin: 0;
    color: var(--color-ivory);
  }

  .events-hero__introduction {
    max-width: 37rem;
    margin: 0.9rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 76%, transparent);
    font-size: clamp(1rem, calc(0.954rem + 0.19vw), 1.125rem);
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .events-hero {
      min-height: 23rem;
    }

    .events-hero__container {
      padding-bottom: 4rem;
    }
  }
</style>
