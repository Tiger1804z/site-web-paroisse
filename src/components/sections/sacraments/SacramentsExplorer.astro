---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import type { SacramentsOverviewItem } from '@/types/sacraments';

interface Props {
  items: readonly SacramentsOverviewItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section
      class="sacraments-explorer"
      aria-label="Sacrements et autres demandes"
      data-sacraments-tabs
    >
      <Container>
        <div
          class="sacraments-explorer__tabs"
          role="tablist"
          aria-label="Choisir une démarche"
        >
          {items.map((item, index) => (
            <button
              id={`sacraments-tab-${item.id}`}
              class="sacraments-explorer__tab"
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`sacraments-panel-${item.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-sacraments-tab
            >
              {item.tabLabel}
            </button>
          ))}
        </div>

        <div class="sacraments-explorer__panels">
          {items.map((item, index) => (
            <section
              id={`sacraments-panel-${item.id}`}
              class:list={[
                'sacraments-explorer__panel',
                item.kind === 'services' &&
                  'sacraments-explorer__panel--services',
              ]}
              role="tabpanel"
              aria-labelledby={`sacraments-tab-${item.id}`}
              tabindex="0"
              hidden={index !== 0}
              data-sacraments-panel
            >
              {item.kind === 'sacrament' ? (
                <div class="sacrament-feature">
                  <div class="sacrament-feature__content">
                    <p class="sacrament-feature__eyebrow type-eyebrow">
                      {item.eyebrow}
                    </p>
                    <h2>{item.title}</h2>
                    <p class="sacrament-feature__summary">{item.summary}</p>

                    {item.information && (
                      <div class="sacrament-feature__information">
                        <h3>{item.information.title}</h3>
                        <ul>
                          {item.information.items.map((information) => (
                            <li>
                              <span aria-hidden="true" />
                              {information}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {item.notice && (
                      <aside class="sacrament-feature__notice">
                        <h3>{item.notice.title}</h3>
                        <p>{item.notice.message}</p>
                      </aside>
                    )}

                    {item.primaryCta && (
                      <Button href={item.primaryCta.href}>
                        {item.primaryCta.label}
                      </Button>
                    )}
                  </div>

                  <figure
                    class="sacrament-feature__media"
                    style={[
                      `--sacrament-position-desktop: ${item.image.desktopPosition ?? 'center'}`,
                      `--sacrament-position-mobile: ${item.image.mobilePosition ?? item.image.desktopPosition ?? 'center'}`,
                    ].join('; ')}
                  >
                    <Image
                      src={item.image.image}
                      alt={item.image.alt}
                      widths={[480, 720, 960, 1200]}
                      sizes="(min-width: 64rem) 50vw, 100vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </div>
              ) : (
                <div class="services-overview">
                  <p class="services-overview__eyebrow type-eyebrow">
                    {item.eyebrow}
                  </p>
                  <h2>{item.title}</h2>
                  <p class="services-overview__summary">{item.summary}</p>

                  {item.services.length > 0 && (
                    <ul class="services-overview__list">
                      {item.services.map((service) => (
                        <li>
                          <h3>{service.title}</h3>
                          <p>{service.summary}</p>
                        </li>
                      ))}
                    </ul>
                  )}

                  {item.primaryCta && (
                    <Button href={item.primaryCta.href}>
                      {item.primaryCta.label}
                    </Button>
                  )}
                </div>
              )}
            </section>
          ))}
        </div>
      </Container>
    </section>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>('[data-sacraments-tabs]')
    .forEach((tabsRoot) => {
      if (tabsRoot.dataset.initialized === 'true') return;
      tabsRoot.dataset.initialized = 'true';

      const tabs = Array.from(
        tabsRoot.querySelectorAll<HTMLButtonElement>('[data-sacraments-tab]'),
      );
      const panels = Array.from(
        tabsRoot.querySelectorAll<HTMLElement>('[data-sacraments-panel]'),
      );

      const activateTab = (index: number, moveFocus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== index;
        });
        if (moveFocus) tabs[index]?.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(index));
        tab.addEventListener('keydown', (event) => {
          let nextIndex = index;

          if (event.key === 'ArrowRight') {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === 'ArrowLeft') {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === 'Home') {
            nextIndex = 0;
          } else if (event.key === 'End') {
            nextIndex = tabs.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          activateTab(nextIndex, true);
        });
      });
    });
</script>

<style>
  .sacraments-explorer {
    padding-block: 6rem;
    background: var(--color-ivory);
  }

  .sacraments-explorer__tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 3rem;
    overflow-x: auto;
    overflow-y: hidden;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 20%, transparent);
    scrollbar-width: thin;
  }

  .sacraments-explorer__tab {
    position: relative;
    min-height: 3.25rem;
    flex: 0 0 auto;
    margin-bottom: -1px;
    padding: 0.875rem 1.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--color-muted);
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--duration-short) var(--ease-editorial),
      border-color var(--duration-short) var(--ease-editorial);
  }

  .sacraments-explorer__tab:hover {
    color: var(--color-charcoal);
  }

  .sacraments-explorer__tab[aria-selected='true'] {
    border-bottom-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .sacraments-explorer__panel:focus {
    outline: none;
  }

  .sacraments-explorer__panel:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 0.5rem;
  }

  .sacrament-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .sacrament-feature__content {
    min-width: 0;
  }

  .sacrament-feature__eyebrow,
  .services-overview__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-gold);
  }

  .sacrament-feature h2,
  .services-overview h2 {
    margin: 0;
    color: var(--color-charcoal);
    font-size: clamp(2.25rem, calc(1.9rem + 1.45vw), 3rem);
    font-weight: 600;
    line-height: 1.08;
    text-wrap: balance;
  }

  .sacrament-feature__summary,
  .services-overview__summary {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .sacrament-feature__information {
    margin-top: 2rem;
  }

  .sacrament-feature__information h3,
  .sacrament-feature__notice h3 {
    margin: 0;
    color: var(--color-charcoal);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .sacrament-feature__information ul {
    display: grid;
    gap: 0.625rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sacrament-feature__information li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .sacrament-feature__information li span {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 0.375rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .sacrament-feature__notice {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 20%, transparent);
    background: var(--color-paper);
  }

  .sacrament-feature__notice p {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .sacrament-feature__media {
    margin: 0;
    overflow: hidden;
    background: var(--color-paper);
  }

  .sacrament-feature__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--sacrament-position-mobile);
  }

  .services-overview {
    max-width: 50rem;
  }

  .services-overview__list {
    display: grid;
    margin: 2.5rem 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 24%, transparent);
    list-style: none;
  }

  .services-overview__list li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 20%, transparent);
  }

  .services-overview__list h3,
  .services-overview__list p {
    margin: 0;
  }

  .services-overview__list h3 {
    color: var(--color-charcoal);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .services-overview__list p {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .sacraments-explorer {
      padding-block: 8.75rem;
    }

    .sacraments-explorer__tab {
      min-height: 3.5rem;
      padding-inline: 1.5rem;
    }

    .services-overview__list li {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .sacrament-feature {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }

    .sacrament-feature__media :global(img) {
      object-position: var(--sacrament-position-desktop);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sacraments-explorer__tab {
      transition: none;
    }
  }
</style>
