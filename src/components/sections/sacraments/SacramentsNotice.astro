---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import type { SacramentsNotice as SacramentsNoticeContent } from '@/types/sacraments';

interface Props {
  notice?: SacramentsNoticeContent;
}

const { notice } = Astro.props;
---

{
  notice?.active && (
    <aside class="sacraments-notice" aria-labelledby="sacraments-notice-title">
      <Container>
        <div class="sacraments-notice__inner">
          <div>
            <h2 id="sacraments-notice-title">{notice.title}</h2>
            <p>{notice.message}</p>
          </div>
          {notice.primaryCta && (
            <Button
              class="sacraments-notice__button"
              href={notice.primaryCta.href}
            >
              {notice.primaryCta.label}
            </Button>
          )}
        </div>
      </Container>
    </aside>
  )
}

<style>
  .sacraments-notice {
    padding-block: 1.25rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 20%, transparent);
    background: var(--color-paper);
  }

  .sacraments-notice__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .sacraments-notice h2,
  .sacraments-notice p {
    margin: 0;
  }

  .sacraments-notice h2 {
    color: var(--color-charcoal);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .sacraments-notice p {
    max-width: 44rem;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .sacraments-notice__button {
    flex: 0 0 auto;
  }

  @media (min-width: 40rem) {
    .sacraments-notice__inner {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
