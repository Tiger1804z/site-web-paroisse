---
import Container from '@/components/ui/Container.astro';
import type { SacramentsFaq as SacramentsFaqContent } from '@/types/sacraments';

interface Props {
  faq?: SacramentsFaqContent;
}

const { faq } = Astro.props;
---

{
  faq && faq.items.length > 0 && (
    <section class="sacraments-faq" aria-labelledby="sacraments-faq-title">
      <Container>
        <div class="sacraments-faq__inner">
          <h2 id="sacraments-faq-title">{faq.title}</h2>
          <div class="sacraments-faq__list">
            {faq.items.map((item) => (
              <details name="sacraments-faq">
                <summary>
                  <span>{item.question}</span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="m19 9-7 7-7-7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <div class="sacraments-faq__answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )
}

<style>
  .sacraments-faq {
    padding-block: 5rem 7rem;
    background: var(--color-ivory);
  }

  .sacraments-faq__inner {
    max-width: 50rem;
    margin-inline: auto;
  }

  .sacraments-faq h2 {
    margin: 0 0 2.5rem;
    color: var(--color-charcoal);
    font-size: clamp(2rem, calc(1.721rem + 1.143vw), 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }

  .sacraments-faq__list {
    display: grid;
    gap: 0.25rem;
  }

  .sacraments-faq details {
    border: 1px solid color-mix(in srgb, var(--color-gold) 20%, transparent);
    background: var(--color-paper);
  }

  .sacraments-faq summary {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-short) var(--ease-editorial);
  }

  .sacraments-faq summary::-webkit-details-marker {
    display: none;
  }

  .sacraments-faq summary:hover {
    background: var(--color-ivory);
  }

  .sacraments-faq summary svg {
    flex: 0 0 auto;
    color: var(--color-gold);
    transition: rotate var(--duration-normal) var(--ease-editorial);
  }

  .sacraments-faq details[open] summary svg {
    rotate: 180deg;
  }

  .sacraments-faq__answer {
    padding: 1rem 1.5rem 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 15%, transparent);
  }

  .sacraments-faq__answer p {
    max-width: 42.5rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  @media (min-width: 48rem) {
    .sacraments-faq {
      padding-block: 5rem 8.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sacraments-faq summary,
    .sacraments-faq summary svg {
      transition: none;
    }
  }
</style>
