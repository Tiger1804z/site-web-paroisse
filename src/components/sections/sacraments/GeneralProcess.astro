---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { GeneralProcess as GeneralProcessContent } from '@/types/sacraments';

interface Props {
  process?: GeneralProcessContent;
}

const { process } = Astro.props;
---

{
  process && process.steps.length > 0 && (
    <section class="general-process" aria-labelledby="general-process-title">
      <Container>
        <header class="general-process__header" data-motion-reveal>
          <Eyebrow>{process.eyebrow}</Eyebrow>
          <h2 id="general-process-title">{process.title}</h2>
          {process.introduction && <p>{process.introduction}</p>}
        </header>

        <ol class="general-process__steps" data-motion-stagger>
          {process.steps.map((step) => (
            <li data-motion-item>
              <span class="general-process__number" aria-hidden="true">
                {step.numberLabel}
              </span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))}
        </ol>

        {process.primaryCta && (
          <div class="general-process__action" data-motion-reveal>
            <Button href={process.primaryCta.href}>
              {process.primaryCta.label}
            </Button>
          </div>
        )}
      </Container>
    </section>
  )
}

<style>
  .general-process {
    padding-block: 6rem;
    background: var(--color-paper);
  }

  .general-process__header {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .general-process__header h2,
  .general-process__header p {
    margin: 0;
  }

  .general-process__header h2 {
    margin-top: 1rem;
    color: var(--color-charcoal);
    font-size: clamp(2rem, calc(1.721rem + 1.143vw), 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }

  .general-process__header p {
    max-width: 39rem;
    margin: 1rem auto 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .general-process__steps {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .general-process__steps li {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .general-process__number {
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 4rem;
    place-items: center;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    color: var(--color-ivory);
    background: var(--color-burgundy);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .general-process__steps h3,
  .general-process__steps p {
    margin: 0;
  }

  .general-process__steps h3 {
    max-width: 13rem;
    color: var(--color-charcoal);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .general-process__steps p {
    max-width: 15rem;
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .general-process__action {
    margin-top: 3.5rem;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .general-process {
      padding-block: 8.75rem;
    }

    .general-process__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .general-process__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .general-process__steps::before {
      position: absolute;
      z-index: 0;
      top: 2rem;
      right: 8%;
      left: 8%;
      height: 1px;
      background: color-mix(in srgb, var(--color-gold) 20%, transparent);
      content: '';
    }
  }
</style>
