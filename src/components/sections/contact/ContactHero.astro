---
import Container from '@/components/ui/Container.astro';
import type { ContactPageData } from '@/types/contact';

interface Props {
  hero: ContactPageData['hero'];
}

const { hero } = Astro.props;
---

<section class="contact-hero" aria-labelledby="contact-hero-title">
  <div class="contact-hero__arc" aria-hidden="true"></div>
  <Container>
    <div class="contact-hero__content">
      <p class="contact-hero__eyebrow type-eyebrow">{hero.eyebrow}</p>
      <h1 id="contact-hero-title">{hero.title}</h1>
      <p class="contact-hero__introduction">{hero.introduction}</p>
    </div>
  </Container>
</section>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 5rem;
    background: var(--color-burgundy);
    color: var(--color-ivory);
  }

  .contact-hero__arc {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(31.25rem, 80vw);
    height: 15.625rem;
    translate: -50% 0;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 5%, transparent);
    border-top: 0;
    border-radius: 0 0 999px 999px;
    pointer-events: none;
  }

  .contact-hero__content {
    position: relative;
    max-width: 32rem;
  }

  .contact-hero__eyebrow {
    margin: 0 0 1rem;
    color: color-mix(in srgb, var(--color-gold) 80%, transparent);
  }

  .contact-hero h1 {
    margin: 0;
    color: var(--color-ivory);
    font-size: clamp(2.75rem, calc(2.17rem + 2.42vw), 3.75rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .contact-hero__introduction {
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 64%, transparent);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
</style>
