---
import type { SchedulePeriod } from '@/types/schedule';

interface Props {
  period: SchedulePeriod;
  reviewedAtLabel?: string;
}

const { period, reviewedAtLabel } = Astro.props;
---

{
  period.active && (
    <section
      class="regular-schedule"
      aria-labelledby={`schedule-period-${period.id}`}
    >
      <div class="regular-schedule__heading">
        <h2 id={`schedule-period-${period.id}`}>{period.title}</h2>
        {period.description && <p>{period.description}</p>}
      </div>

      {period.entries.length > 0 ? (
        <dl class="schedule-list">
          {period.entries.map((entry, index) => (
            <div
              class="schedule-list__entry"
              data-muted={
                index === period.entries.length - 1 ? 'true' : 'false'
              }
            >
              <dt>
                <span class="schedule-list__day">{entry.dayLabel}</span>
                {entry.note && (
                  <span class="schedule-list__note">{entry.note}</span>
                )}
              </dt>
              <dd>
                <ul aria-label={`Heures pour ${entry.dayLabel}`}>
                  {entry.times.map((time) => (
                    <li>
                      <span>{time.label}</span>
                      {time.note && <small>{time.note}</small>}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="schedule-list__empty">Horaires à confirmer.</p>
      )}

      {reviewedAtLabel && (
        <p class="regular-schedule__updated">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Horaires vérifiés le {reviewedAtLabel}</span>
        </p>
      )}
    </section>
  )
}

<style>
  .regular-schedule__heading {
    max-width: 42.5rem;
    margin-bottom: 2rem;
  }

  .regular-schedule__heading h2 {
    margin: 0;
    color: var(--color-charcoal);
    font-size: clamp(2rem, calc(1.814rem + 0.762vw), 2.5rem);
    font-weight: 600;
    line-height: 1.16;
  }

  .regular-schedule__heading p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .schedule-list {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    background: var(--color-surface);
  }

  .schedule-list__entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, auto);
    gap: 1.5rem;
    align-items: center;
    min-height: 5.25rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 16%, transparent);
  }

  .schedule-list__entry:last-child {
    border-bottom: 0;
  }

  .schedule-list__entry[data-muted='true'] {
    background: var(--color-paper);
  }

  .schedule-list dt {
    display: grid;
    gap: 0.15rem;
  }

  .schedule-list__day {
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .schedule-list__note {
    color: var(--color-muted);
    font-size: var(--font-size-meta);
    line-height: 1.5;
    letter-spacing: 0.025em;
  }

  .schedule-list dd {
    margin: 0;
    text-align: right;
  }

  .schedule-list ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .schedule-list li {
    display: grid;
    justify-items: end;
  }

  .schedule-list li > span {
    color: var(--color-burgundy);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .schedule-list li small {
    color: var(--color-muted);
    font-size: var(--font-size-meta);
  }

  .schedule-list__empty {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .regular-schedule__updated {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: var(--font-size-meta);
    line-height: 1.5;
  }

  .regular-schedule__updated svg {
    flex: 0 0 auto;
  }

  @media (max-width: 30rem) {
    .schedule-list__entry {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      align-items: start;
    }

    .schedule-list dd {
      text-align: left;
    }

    .schedule-list li {
      justify-items: start;
    }
  }
</style>
