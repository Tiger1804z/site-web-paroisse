---
import TextLink from '@/components/ui/TextLink.astro';
import type { ScheduleSidebarContent } from '@/types/schedule';

interface Props {
  content: ScheduleSidebarContent;
}

const { content } = Astro.props;
---

<aside
  class="schedule-sidebar schedule-sidebar--single"
  aria-label="Informations pratiques"
>
  <section
    class="schedule-sidebar__office"
    aria-labelledby="schedule-office-title"
  >
    <h2
      id="schedule-office-title"
      class="schedule-sidebar__eyebrow schedule-sidebar__eyebrow--dark"
    >
      {content.office.eyebrow}
    </h2>
    {
      content.office.hoursLabel && (
        <p class="schedule-sidebar__hours">{content.office.hoursLabel}</p>
      )
    }
    <p class="schedule-sidebar__message">{content.office.message}</p>
    <TextLink href={content.office.link.href}>
      {content.office.link.label}
    </TextLink>
  </section>
</aside>

<style>
  .schedule-sidebar {
    display: grid;
    gap: 1.5rem;
  }

  .schedule-sidebar__office {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    background: var(--color-surface);
  }

  .schedule-sidebar__eyebrow {
    margin: 0 0 0.75rem;
    color: color-mix(in srgb, var(--color-gold) 82%, var(--color-ivory));
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .schedule-sidebar__eyebrow--dark {
    color: var(--color-wood);
  }

  .schedule-sidebar__hours {
    margin: 0;
    color: var(--color-charcoal);
    font-size: var(--font-size-ui);
    font-weight: 600;
    /* Les heures viennent d’un champ multiligne : les retours saisis par
       l’éditrice sont conservés tels quels. */
    white-space: pre-line;
  }

  .schedule-sidebar__message {
    margin: 0.5rem 0 0.75rem;
    color: var(--color-muted);
    font-size: var(--font-size-meta);
    line-height: 1.65;
  }

  @media (min-width: 40rem) and (max-width: 63.999rem) {
    .schedule-sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .schedule-sidebar--single {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
