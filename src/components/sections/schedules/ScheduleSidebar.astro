---
import Button from '@/components/ui/Button.astro';
import TextLink from '@/components/ui/TextLink.astro';
import type { ScheduleSidebarContent } from '@/types/schedule';

interface Props {
  content: ScheduleSidebarContent;
}

const { content } = Astro.props;
---

<aside
  class:list={[
    'schedule-sidebar',
    !content.bulletin.active && 'schedule-sidebar--single',
  ]}
  aria-label="Informations pratiques"
>
  {
    content.bulletin.active && (
      <section
        class="schedule-sidebar__bulletin"
        aria-labelledby="schedule-bulletin-title"
      >
        <p class="schedule-sidebar__eyebrow">{content.bulletin.eyebrow}</p>
        <h2 id="schedule-bulletin-title">{content.bulletin.title}</h2>
        <p class="schedule-sidebar__period">{content.bulletin.periodLabel}</p>
        <Button href={content.bulletin.link.href} variant="light">
          {content.bulletin.link.label}
        </Button>
      </section>
    )
  }

  <section
    class="schedule-sidebar__office"
    aria-labelledby="schedule-office-title"
  >
    <h2
      id="schedule-office-title"
      class="schedule-sidebar__eyebrow schedule-sidebar__eyebrow--dark"
    >
      {content.office.eyebrow}
    </h2>
    <p class="schedule-sidebar__hours">{content.office.hoursLabel}</p>
    <p class="schedule-sidebar__message">{content.office.message}</p>
    <TextLink href={content.office.link.href}>
      {content.office.link.label}
    </TextLink>
  </section>
</aside>

<style>
  .schedule-sidebar {
    display: grid;
    gap: 1.5rem;
  }

  .schedule-sidebar__bulletin,
  .schedule-sidebar__office {
    padding: 1.5rem;
  }

  .schedule-sidebar__bulletin {
    background: var(--color-burgundy);
    color: var(--color-ivory);
  }

  .schedule-sidebar__office {
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    background: var(--color-surface);
  }

  .schedule-sidebar__eyebrow {
    margin: 0 0 0.75rem;
    color: color-mix(in srgb, var(--color-gold) 82%, var(--color-ivory));
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .schedule-sidebar__eyebrow--dark {
    color: var(--color-wood);
  }

  .schedule-sidebar__bulletin h2 {
    margin: 0;
    color: var(--color-ivory);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .schedule-sidebar__period {
    margin: 0.5rem 0 1.25rem;
    color: color-mix(in srgb, var(--color-ivory) 68%, transparent);
    font-size: 0.875rem;
  }

  .schedule-sidebar__bulletin :global(.ui-button) {
    width: 100%;
  }

  .schedule-sidebar__hours {
    margin: 0;
    color: var(--color-charcoal);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .schedule-sidebar__message {
    margin: 0.5rem 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.65;
  }

  @media (min-width: 40rem) and (max-width: 63.999rem) {
    .schedule-sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .schedule-sidebar--single {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
