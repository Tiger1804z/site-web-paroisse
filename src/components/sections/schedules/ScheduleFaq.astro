---
import type { ScheduleFaqItem } from '@/types/schedule';

interface Props {
  items: readonly ScheduleFaqItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="schedule-faq" aria-labelledby="schedule-faq-title">
      <h2 id="schedule-faq-title">Questions fréquentes</h2>
      <div class="schedule-faq__list">
        {items.map((item) => (
          <details name="schedule-faq">
            <summary>
              <span>{item.question}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="m19 9-7 7-7-7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="schedule-faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .schedule-faq h2 {
    margin: 0 0 1.5rem;
    color: var(--color-charcoal);
    font-size: clamp(1.75rem, calc(1.471rem + 1.143vw), 2.25rem);
    font-weight: 600;
    line-height: 1.16;
  }

  .schedule-faq__list {
    display: grid;
    gap: 0.25rem;
  }

  .schedule-faq details {
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    background: var(--color-surface);
  }

  .schedule-faq summary {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-short) var(--ease-editorial);
  }

  .schedule-faq summary::-webkit-details-marker {
    display: none;
  }

  .schedule-faq summary:hover {
    background: var(--color-paper);
  }

  .schedule-faq summary svg {
    flex: 0 0 auto;
    color: var(--color-gold);
    transition: rotate var(--duration-normal) var(--ease-editorial);
  }

  .schedule-faq details[open] summary svg {
    rotate: 180deg;
  }

  .schedule-faq__answer {
    padding: 1rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 16%, transparent);
  }

  .schedule-faq__answer p {
    max-width: 42.5rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
