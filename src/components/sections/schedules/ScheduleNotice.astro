---
import TextLink from '@/components/ui/TextLink.astro';
import type { ScheduleNotice as ScheduleNoticeData } from '@/types/schedule';

interface Props {
  notice?: ScheduleNoticeData;
}

const { notice } = Astro.props;
---

{
  notice?.active && (
    <aside
      class="schedule-notice"
      data-severity={notice.severity}
      aria-labelledby={`schedule-notice-${notice.id}`}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <div>
        <p id={`schedule-notice-${notice.id}`} class="schedule-notice__title">
          {notice.title}
        </p>
        <p class="schedule-notice__message">{notice.message}</p>
        {notice.action && (
          <TextLink href={notice.action.href}>{notice.action.label}</TextLink>
        )}
      </div>
    </aside>
  )
}

<style>
  .schedule-notice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--notice-accent, var(--color-gold));
    background: var(--notice-background, var(--color-paper));
    color: var(--color-charcoal);
  }

  .schedule-notice[data-severity='info'] {
    --notice-accent: var(--color-marian);
    --notice-background: color-mix(
      in srgb,
      var(--color-marian) 12%,
      var(--color-surface)
    );
  }

  .schedule-notice[data-severity='important'] {
    --notice-accent: var(--color-gold);
  }

  .schedule-notice[data-severity='special'] {
    --notice-accent: var(--color-rose);
    --notice-background: color-mix(
      in srgb,
      var(--color-rose) 18%,
      var(--color-surface)
    );
  }

  .schedule-notice > svg {
    margin-top: 0.1rem;
    color: var(--notice-accent);
  }

  .schedule-notice__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .schedule-notice__message {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .schedule-notice :global(.ui-text-link) {
    margin-top: 0.5rem;
  }
</style>
