---
import TextLink from '@/components/ui/TextLink.astro';
import type { SpecialCelebration } from '@/types/schedule';

interface Props {
  celebrations: readonly SpecialCelebration[];
  emptyMessage: string;
}

const { celebrations, emptyMessage } = Astro.props;
---

<section
  id="celebrations-speciales"
  class="special-celebrations"
  aria-labelledby="special-celebrations-title"
>
  <h2 id="special-celebrations-title">Célébrations spéciales</h2>

  {
    celebrations.length > 0 ? (
      <div class="special-celebrations__list">
        {celebrations.map((celebration) => (
          <article aria-labelledby={`celebration-${celebration.id}`}>
            <div>
              <p class="special-celebrations__date">{celebration.dateLabel}</p>
              <h3 id={`celebration-${celebration.id}`}>{celebration.title}</h3>
              {celebration.note && (
                <p class="special-celebrations__note">{celebration.note}</p>
              )}
            </div>
            {celebration.timeLabel && (
              <p class="special-celebrations__time">{celebration.timeLabel}</p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="special-celebrations__empty">{emptyMessage}</p>
    )
  }

  <TextLink href="/evenements/">Voir tous les événements</TextLink>
</section>

<style>
  .special-celebrations h2 {
    margin: 0 0 1.5rem;
    color: var(--color-charcoal);
    font-size: clamp(1.75rem, calc(1.471rem + 1.143vw), 2.25rem);
    font-weight: 600;
    line-height: 1.16;
  }

  .special-celebrations__list {
    display: grid;
    gap: 0.75rem;
  }

  .special-celebrations article,
  .special-celebrations__empty {
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--color-gold);
    background: var(--color-paper);
  }

  .special-celebrations article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
  }

  .special-celebrations__date {
    margin: 0 0 0.25rem;
    color: var(--color-wood);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .special-celebrations h3 {
    margin: 0;
    color: var(--color-charcoal);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .special-celebrations__note {
    display: inline-flex;
    margin: 0.5rem 0 0;
    padding: 0.15rem 0.5rem;
    background: color-mix(in srgb, var(--color-burgundy) 10%, transparent);
    color: var(--color-burgundy);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .special-celebrations__time {
    margin: 0;
    color: var(--color-burgundy);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .special-celebrations__empty {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .special-celebrations :global(.ui-text-link) {
    margin-top: 1rem;
  }

  @media (max-width: 30rem) {
    .special-celebrations article {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      align-items: start;
    }
  }
</style>
