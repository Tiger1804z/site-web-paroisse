---
import Container from '@/components/ui/Container.astro';
import RemoteImage from '@/components/ui/RemoteImage.astro';
import type { ThriftStorePageData } from '@/types/thriftStore';

interface Props {
  gallery: ThriftStorePageData['gallery'];
}

const { gallery } = Astro.props;
---

<section class="thrift-gallery" aria-labelledby="thrift-gallery-title">
  <Container>
    <div class="thrift-gallery__heading">
      <p>{gallery.eyebrow}</p>
      <h2 id="thrift-gallery-title">{gallery.title}</h2>
      <div>{gallery.introduction}</div>
    </div>

    <div class="thrift-gallery__grid">
      {
        gallery.items.map((item) => (
          <figure class="thrift-gallery__item">
            <RemoteImage
              image={item.image}
              sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 100vw"
            />
            <figcaption>
              <span class="thrift-gallery__item-title">{item.title}</span>
              {item.description && <span>{item.description}</span>}
              {item.image.credit && (
                <span class="thrift-gallery__item-credit">
                  Photo : {item.image.credit}
                </span>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .thrift-gallery {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-ivory);
  }

  .thrift-gallery__heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .thrift-gallery__heading > p {
    margin: 0;
    color: var(--color-gold);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .thrift-gallery h2 {
    margin: 0;
    color: var(--color-charcoal);
    font-size: clamp(2.5rem, calc(2.1rem + 1.65vw), 3.5rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .thrift-gallery__heading > div {
    max-width: 45rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .thrift-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1rem);
  }

  .thrift-gallery__item {
    display: grid;
    margin: 0;
    gap: 0.625rem;
  }

  .thrift-gallery__item :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--color-paper);
  }

  .thrift-gallery__item figcaption {
    display: grid;
    gap: 0.25rem;
    color: var(--color-muted);
    font-size: var(--font-size-meta);
    line-height: 1.5;
  }

  .thrift-gallery__item-title {
    color: var(--color-charcoal);
    font-weight: 600;
  }

  .thrift-gallery__item-credit {
    font-size: var(--font-size-micro);
  }

  @media (min-width: 48rem) {
    .thrift-gallery__heading {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
      align-items: end;
    }

    .thrift-gallery__heading > p,
    .thrift-gallery h2 {
      grid-column: 1;
    }

    .thrift-gallery__heading > div {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .thrift-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
