---
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { RoomRentalPageData } from '@/types/roomRental';

interface Props {
  church: NonNullable<RoomRentalPageData['church']>;
}

const { church } = Astro.props;
---

<section
  id={church.id}
  class="rental-church"
  aria-labelledby="rental-church-title"
>
  <Container>
    <div class="rental-church__layout" data-motion-reveal>
      <div class="rental-church__copy">
        <Eyebrow tone="light">{church.eyebrow}</Eyebrow>
        <h2 id="rental-church-title">{church.title}</h2>
        <p>{church.description}</p>
        {church.note && <p class="rental-church__note">{church.note}</p>}
      </div>

      {
        (church.capacity || church.price) && (
          <dl class="rental-church__facts">
            {church.capacity && (
              <div>
                <dt>Capacité</dt>
                <dd>{church.capacity}</dd>
              </div>
            )}
            {church.price && (
              <div>
                <dt>Tarif</dt>
                <dd>{church.price}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>
  </Container>
</section>

<style>
  /*
   * L'église n'est pas une salle de plus, et la page ne doit pas la présenter
   * comme telle : elle n'a ni cuisinette ni vestiaire, elle se loue à la
   * journée, et pas à tout le monde. D'où un bloc à part, sur fond sombre.
   */
  .rental-church {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .rental-church__layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .rental-church__copy {
    max-width: 40rem;
  }

  .rental-church h2 {
    margin: 0.75rem 0 0;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.6rem + 1.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .rental-church p {
    margin: 1.25rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .rental-church__note {
    color: var(--color-gold);
    font-size: var(--font-size-meta);
  }

  .rental-church__facts {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
  }

  .rental-church__facts dt {
    color: var(--color-gold);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rental-church__facts dd {
    margin: 0.35rem 0 0;
    color: var(--color-ivory);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .rental-church__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .rental-church__layout {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .rental-church__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
