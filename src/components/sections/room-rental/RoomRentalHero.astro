---
import RemoteImage from '@/components/ui/RemoteImage.astro';
import Container from '@/components/ui/Container.astro';
import type { RoomRentalPageData } from '@/types/roomRental';

interface Props {
  hero: RoomRentalPageData['hero'];
}

const { hero } = Astro.props;
---

<section class="rental-hero" aria-labelledby="rental-hero-title">
  {
    hero.image && (
      <RemoteImage
        class="rental-hero__image"
        image={hero.image}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="rental-hero__overlay" aria-hidden="true"></div>
  <div class="rental-hero__line" aria-hidden="true"></div>

  <Container class="rental-hero__container">
    <div class="rental-hero__content">
      <p class="rental-hero__eyebrow type-eyebrow">{hero.eyebrow}</p>
      <h1 id="rental-hero-title">{hero.title}</h1>
      <p class="rental-hero__introduction">{hero.introduction}</p>
    </div>
  </Container>
</section>

<style>
  .rental-hero {
    position: relative;
    display: grid;
    min-height: clamp(28rem, 58svh, 40rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .rental-hero__image,
  .rental-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .rental-hero__image {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rental-hero__overlay {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgb(28 25 24 / 86%) 0%,
        rgb(46 16 25 / 64%) 48%,
        rgb(28 25 24 / 44%) 100%
      ),
      linear-gradient(to top, rgb(28 25 24 / 66%), transparent 55%);
  }

  .rental-hero__line {
    position: absolute;
    z-index: -1;
    right: clamp(1.25rem, 8vw, 8rem);
    bottom: 0;
    width: 1px;
    height: 38%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-gold) 76%, transparent)
    );
  }

  .rental-hero__container {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-top: calc(var(--header-height) + 4rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .rental-hero__content {
    max-width: 45rem;
  }

  .rental-hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-gold);
  }

  .rental-hero h1 {
    margin: 0;
    color: var(--color-ivory);
    font-size: clamp(3rem, calc(2.2rem + 3.4vw), 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .rental-hero__introduction {
    max-width: 39rem;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
    font-size: clamp(1.0625rem, calc(1rem + 0.28vw), 1.25rem);
    line-height: 1.75;
  }

  @media (max-width: 47.999rem) {
    .rental-hero {
      min-height: 30rem;
    }

    .rental-hero__overlay {
      background:
        linear-gradient(to right, rgb(28 25 24 / 78%), rgb(46 16 25 / 52%)),
        linear-gradient(to top, rgb(28 25 24 / 76%), transparent 65%);
    }
  }
</style>
