---
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type {
  AboutPrinciples as AboutPrinciplesContent,
  AboutPrincipleSymbol,
} from '@/types/about';

interface Props {
  principles: AboutPrinciplesContent;
}

const { principles } = Astro.props;

const symbolPaths: Record<AboutPrincipleSymbol, string> = {
  book: 'M12 6.04A8.97 8.97 0 0 0 6 3.75c-1.05 0-2.06.18-3 .51v14.25A8.99 8.99 0 0 1 6 18c2.3 0 4.41.87 6 2.29m0-14.25A8.97 8.97 0 0 1 18 3.75c1.05 0 2.06.18 3 .51v14.25A8.99 8.99 0 0 0 18 18a8.97 8.97 0 0 0-6 2.29m0-14.25v14.25',
  people:
    'M15 19.13a9.38 9.38 0 0 0 2.63.37 9.34 9.34 0 0 0 4.12-.95 4.13 4.13 0 0 0-7.53-2.49M15 19.13c0-1.11-.29-2.16-.79-3.07m.79 3.07v.1A12.32 12.32 0 0 1 8.62 21c-2.33 0-4.51-.65-6.37-1.77v-.1a6.38 6.38 0 0 1 11.96-3.07M12 6.38a3.38 3.38 0 1 1-6.75 0 3.38 3.38 0 0 1 6.75 0Zm8.25 2.25a2.63 2.63 0 1 1-5.25 0 2.63 2.63 0 0 1 5.25 0Z',
  heart:
    'M21 8.25c0-2.49-2.1-4.5-4.69-4.5-1.93 0-3.6 1.13-4.31 2.73-.72-1.6-2.38-2.73-4.31-2.73C5.1 3.75 3 5.76 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z',
};
---

<section
  class="about-principles section-block"
  aria-labelledby="principles-title"
>
  <div class="about-principles__beam" aria-hidden="true"></div>
  <Container>
    <header class="about-principles__header">
      <Eyebrow tone="light">{principles.eyebrow}</Eyebrow>
      <h2 id="principles-title" class="about-principles__title type-h2">
        {principles.title}
      </h2>
    </header>

    <div class="about-principles__grid">
      {
        principles.items.map((item) => (
          <article class="about-principles__item">
            <div class="about-principles__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  d={symbolPaths[item.symbol]}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .about-principles {
    position: relative;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .about-principles__beam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-gold) 12%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .about-principles__header {
    position: relative;
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .about-principles__title {
    margin: 1rem 0 0;
    color: var(--color-ivory);
  }

  .about-principles__grid {
    position: relative;
    display: grid;
    gap: 1px;
    background: color-mix(in srgb, var(--color-ivory) 12%, transparent);
  }

  .about-principles__item {
    min-width: 0;
    padding: 2rem;
    background: var(--color-charcoal);
  }

  .about-principles__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.5rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    color: var(--color-gold);
  }

  .about-principles__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .about-principles__item h3 {
    margin: 0;
    color: var(--color-ivory);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .about-principles__item p {
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 58%, transparent);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  @media (min-width: 48rem) {
    .about-principles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-principles__item {
      padding: 2.5rem;
    }
  }
</style>
