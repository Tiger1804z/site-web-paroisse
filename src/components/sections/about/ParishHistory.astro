---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { AboutHistory } from '@/types/about';

interface Props {
  history: AboutHistory;
}

const { history } = Astro.props;
const supportingStyle = [
  `--history-position-desktop: ${history.supportingImage.desktopPosition ?? 'center'}`,
  `--history-position-mobile: ${history.supportingImage.mobilePosition ?? history.supportingImage.desktopPosition ?? 'center'}`,
].join('; ');
const consecrationStyle = history.consecration
  ? [
      `--consecration-position-desktop: ${history.consecration.image.desktopPosition ?? 'center'}`,
      `--consecration-position-mobile: ${history.consecration.image.mobilePosition ?? history.consecration.image.desktopPosition ?? 'center'}`,
    ].join('; ')
  : undefined;
---

<section class="parish-history section-block" aria-labelledby="history-title">
  <Container>
    <div class="parish-history__layout">
      <div class="parish-history__content">
        <Eyebrow>{history.eyebrow}</Eyebrow>
        <h2 id="history-title" class="parish-history__title type-h2">
          {history.title}
        </h2>
        <p class="parish-history__introduction type-body">
          {history.introduction}
        </p>

        <ol class="parish-history__timeline" aria-label="Repères historiques">
          {
            history.entries.map((entry) => (
              <li class="parish-history__entry">
                <p class="parish-history__date type-label">{entry.dateLabel}</p>
                <div>
                  <h3 class="parish-history__entry-title">{entry.title}</h3>
                  <p>{entry.description}</p>
                </div>
              </li>
            ))
          }
        </ol>

        {
          history.consecration && (
            <aside
              class="parish-history__consecration"
              aria-labelledby="consecration-title"
            >
              <p class="parish-history__consecration-eyebrow type-eyebrow">
                {history.consecration.eyebrow}
              </p>
              <p class="parish-history__consecration-date type-label">
                {history.consecration.dateLabel}
              </p>
              <h3 id="consecration-title">{history.consecration.title}</h3>
              <p>{history.consecration.description}</p>
              <p class="parish-history__source-note">
                {history.consecration.sourceNote}
              </p>
            </aside>
          )
        }
      </div>

      <div class="parish-history__media">
        <figure class="parish-history__figure" style={supportingStyle}>
          <Image
            src={history.supportingImage.image}
            alt={history.supportingImage.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          {
            history.supportingImage.caption && (
              <figcaption>{history.supportingImage.caption}</figcaption>
            )
          }
        </figure>

        {
          history.consecration && (
            <figure
              class="parish-history__figure parish-history__figure--consecration"
              style={consecrationStyle}
            >
              <Image
                src={history.consecration.image.image}
                alt={history.consecration.image.alt}
                widths={[384, 576, 768]}
                sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 100vw"
                loading="lazy"
                decoding="async"
              />
              {history.consecration.image.caption && (
                <figcaption>{history.consecration.image.caption}</figcaption>
              )}
            </figure>
          )
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .parish-history {
    background: var(--color-paper);
  }

  .parish-history__layout {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .parish-history__content {
    min-width: 0;
  }

  .parish-history__title {
    margin: 1rem 0 1.5rem;
    color: var(--color-charcoal);
  }

  .parish-history__introduction {
    max-width: 39rem;
    margin: 0;
    color: var(--color-muted);
  }

  .parish-history__timeline {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .parish-history__entry {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.35fr) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .parish-history__date,
  .parish-history__entry-title,
  .parish-history__entry p {
    margin: 0;
  }

  .parish-history__date {
    color: var(--color-burgundy);
  }

  .parish-history__entry-title {
    color: var(--color-charcoal);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .parish-history__entry p {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .parish-history__consecration {
    margin-top: 2rem;
    padding: 1.5rem;
    border-left: 2px solid var(--color-gold);
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
  }

  .parish-history__consecration-eyebrow,
  .parish-history__consecration-date,
  .parish-history__consecration h3,
  .parish-history__consecration p {
    margin: 0;
  }

  .parish-history__consecration-eyebrow,
  .parish-history__consecration-date {
    color: var(--color-burgundy);
  }

  .parish-history__consecration-date {
    margin-top: 0.75rem;
  }

  .parish-history__consecration h3 {
    margin-top: 0.35rem;
    color: var(--color-charcoal);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .parish-history__consecration h3 + p {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .parish-history__source-note {
    margin-top: 0.75rem !important;
    color: var(--color-brick) !important;
    font-size: 0.75rem !important;
  }

  .parish-history__media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .parish-history__figure {
    display: grid;
    margin: 0;
    overflow: hidden;
    background: var(--color-ivory);
  }

  .parish-history__figure img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: var(--history-position-mobile);
  }

  .parish-history__figure--consecration img {
    object-position: var(--consecration-position-mobile);
  }

  .parish-history__figure figcaption {
    padding: 0.75rem;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  @media (min-width: 40rem) {
    .parish-history__media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .parish-history__figure--consecration {
      margin-top: 2rem;
    }

    .parish-history__figure img {
      object-position: var(--history-position-desktop);
    }

    .parish-history__figure--consecration img {
      object-position: var(--consecration-position-desktop);
    }
  }

  @media (min-width: 64rem) {
    .parish-history__layout {
      grid-template-columns: minmax(0, 1fr) minmax(26rem, 1fr);
      gap: 5rem;
    }
  }

  @media (max-width: 25rem) {
    .parish-history__entry {
      grid-template-columns: 1fr;
    }
  }
</style>
