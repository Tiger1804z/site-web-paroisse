---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import type { AboutHero as AboutHeroContent } from '@/types/about';

interface Props {
  hero: AboutHeroContent;
}

const { hero } = Astro.props;
const heroStyle = [
  `--about-hero-position-desktop: ${hero.image.desktopPosition ?? 'center'}`,
  `--about-hero-position-mobile: ${hero.image.mobilePosition ?? hero.image.desktopPosition ?? 'center'}`,
].join('; ');
---

<section
  class="about-hero"
  style={heroStyle}
  aria-labelledby="about-hero-title"
>
  <Image
    class="about-hero__image"
    src={hero.image.image}
    alt={hero.image.alt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="about-hero__overlay" aria-hidden="true"></div>
  <div class="about-hero__beam" aria-hidden="true"></div>

  <Container class="about-hero__container">
    <div class="about-hero__content">
      <p class="about-hero__eyebrow type-script-accent">{hero.eyebrow}</p>
      <h1 id="about-hero-title" class="about-hero__title type-display">
        {hero.title}
      </h1>
      <p class="about-hero__introduction type-body-large">
        {hero.introduction}
      </p>
    </div>
  </Container>
</section>

<style>
  .about-hero {
    position: relative;
    display: grid;
    min-height: max(34rem, 70svh);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-charcoal);
  }

  .about-hero__image,
  .about-hero__overlay,
  .about-hero__beam {
    position: absolute;
    inset: 0;
  }

  .about-hero__image {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--about-hero-position-mobile);
  }

  .about-hero__overlay {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgb(28 25 24 / 70%) 0%,
        rgb(28 25 24 / 42%) 48%,
        rgb(28 25 24 / 18%) 100%
      ),
      linear-gradient(
        180deg,
        rgb(28 25 24 / 58%) 0%,
        rgb(28 25 24 / 18%) 42%,
        rgb(28 25 24 / 76%) 100%
      );
  }

  .about-hero__beam {
    z-index: -1;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-ivory) 10%, transparent),
      transparent
    );
  }

  .about-hero__container {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-top: calc(var(--header-height) + 3rem);
    padding-bottom: 4rem;
  }

  .about-hero__content {
    max-width: 56rem;
  }

  .about-hero__eyebrow {
    margin: 0 0 0.75rem;
    color: color-mix(in srgb, var(--color-ivory) 68%, transparent);
  }

  .about-hero__title {
    max-width: 52rem;
    margin: 0;
    color: var(--color-ivory);
  }

  .about-hero__introduction {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 76%, transparent);
  }

  @media (min-width: 48rem) {
    .about-hero {
      min-height: max(38rem, 70svh);
    }

    .about-hero__image {
      object-position: var(--about-hero-position-desktop);
    }

    .about-hero__container {
      padding-bottom: 4.5rem;
    }
  }

  @media (min-width: 64rem) {
    .about-hero__container {
      padding-bottom: 5rem;
    }
  }
</style>
