---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import type { ParishLifeFeature as ParishLifeFeatureData } from '@/types/parishLife';

interface Props {
  feature: ParishLifeFeatureData;
  index: number;
}

const { feature, index } = Astro.props;
const imageStyle = [
  `--feature-image-position-desktop: ${feature.visual.desktopPosition ?? 'center'}`,
  `--feature-image-position-mobile: ${feature.visual.mobilePosition ?? feature.visual.desktopPosition ?? 'center'}`,
].join('; ');
---

<article
  id={feature.id}
  class:list={[
    'parish-life-feature',
    index % 2 === 1 && 'parish-life-feature--reverse',
  ]}
  data-motion-reveal
>
  <div class="parish-life-feature__media" style={imageStyle}>
    <Image
      src={feature.visual.image}
      alt={feature.visual.alt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      loading="lazy"
      decoding="async"
    />
    <span class="parish-life-feature__badge">Groupe à confirmer</span>
  </div>

  <div class="parish-life-feature__content">
    <p class="parish-life-feature__eyebrow type-eyebrow">
      {feature.eyebrow}
    </p>
    <h3>{feature.title}</h3>
    <p class="parish-life-feature__summary">{feature.summary}</p>

    <div class="parish-life-feature__details">
      <p class="parish-life-feature__details-label">À découvrir</p>
      <ul>
        {feature.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>

    <Button href={feature.cta.href} variant="secondary">
      {feature.cta.label}
      <span aria-hidden="true">→</span>
    </Button>
  </div>
</article>

<style>
  .parish-life-feature {
    display: grid;
    gap: 2.5rem;
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .parish-life-feature__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .parish-life-feature__media > :global(img),
  .parish-life-feature__media > :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .parish-life-feature__media > :global(img) {
    object-fit: cover;
    object-position: var(--feature-image-position-mobile);
    transition: scale var(--motion-duration-reveal) var(--motion-ease-standard);
  }

  .parish-life-feature__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.375rem 0.75rem;
    background: var(--color-plum);
    color: var(--color-ivory);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .parish-life-feature:nth-child(4n + 2) .parish-life-feature__badge {
    background: var(--color-brick);
  }

  .parish-life-feature:nth-child(4n + 3) .parish-life-feature__badge {
    background: var(--color-marian);
  }

  .parish-life-feature:nth-child(4n + 4) .parish-life-feature__badge {
    background: var(--color-wood);
  }

  .parish-life-feature__content {
    align-self: center;
  }

  .parish-life-feature__eyebrow {
    margin: 0;
    color: var(--color-gold);
  }

  .parish-life-feature h3 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
    font-size: clamp(2rem, calc(1.769rem + 0.96vw), 2.5rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .parish-life-feature__summary {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .parish-life-feature__details {
    display: grid;
    grid-template-columns: minmax(7.5rem, 9rem) minmax(0, 1fr);
    gap: 1rem;
    margin: 2rem 0;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-border);
  }

  .parish-life-feature__details-label {
    margin: 0;
    color: var(--color-gold);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .parish-life-feature__details ul {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
    color: var(--color-charcoal);
    font-size: var(--font-size-ui);
    line-height: 1.55;
    list-style: none;
  }

  .parish-life-feature__details li {
    position: relative;
    padding-left: 1rem;
  }

  .parish-life-feature__details li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.375rem;
    height: 1px;
    background: var(--color-gold);
    content: '';
  }

  @media (hover: hover) and (pointer: fine) {
    .parish-life-feature:hover .parish-life-feature__media > :global(img) {
      scale: var(--motion-scale-hover);
    }
  }

  @media (min-width: 64rem) {
    .parish-life-feature {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: 2.5rem;
    }

    .parish-life-feature__media > :global(img) {
      object-position: var(--feature-image-position-desktop);
    }

    .parish-life-feature--reverse .parish-life-feature__media {
      grid-column: 2;
      grid-row: 1;
    }

    .parish-life-feature--reverse .parish-life-feature__content {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 30rem) {
    .parish-life-feature__details {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parish-life-feature__media > :global(img) {
      transition: none;
    }
  }
</style>
