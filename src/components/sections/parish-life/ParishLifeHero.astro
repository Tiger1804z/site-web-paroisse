---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import type { ParishLifePageData } from '@/types/parishLife';

interface Props {
  hero: ParishLifePageData['hero'];
}

const { hero } = Astro.props;
const heroStyle = [
  `--parish-life-hero-position-desktop: ${hero.image.desktopPosition ?? 'center'}`,
  `--parish-life-hero-position-mobile: ${hero.image.mobilePosition ?? hero.image.desktopPosition ?? 'center'}`,
].join('; ');
---

<section
  class="parish-life-hero"
  style={heroStyle}
  aria-labelledby="parish-life-hero-title"
>
  <Image
    class="parish-life-hero__image"
    src={hero.image.image}
    alt={hero.image.alt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="parish-life-hero__overlay" aria-hidden="true"></div>

  <Container class="parish-life-hero__container">
    <div class="parish-life-hero__content">
      <p class="parish-life-hero__eyebrow type-script-accent">
        {hero.eyebrow}
      </p>
      <h1 id="parish-life-hero-title" class="parish-life-hero__title">
        {hero.title}
      </h1>
      <p class="parish-life-hero__introduction">{hero.introduction}</p>
    </div>
  </Container>
</section>

<style>
  .parish-life-hero {
    position: relative;
    display: grid;
    height: 45svh;
    min-height: 21.25rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-charcoal);
  }

  .parish-life-hero__image,
  .parish-life-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .parish-life-hero__image {
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--parish-life-hero-position-mobile);
  }

  .parish-life-hero__overlay {
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(28 25 24 / 60%),
      rgb(28 25 24 / 76%)
    );
  }

  .parish-life-hero__container {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .parish-life-hero__content {
    max-width: 45rem;
  }

  .parish-life-hero__eyebrow {
    margin: 0 0 0.5rem;
    color: color-mix(in srgb, var(--color-ivory) 62%, transparent);
  }

  .parish-life-hero__title {
    margin: 0;
    color: var(--color-ivory);
    font-size: clamp(2.75rem, calc(2.17rem + 2.42vw), 3.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .parish-life-hero__introduction {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 72%, transparent);
    font-size: clamp(1rem, calc(0.954rem + 0.19vw), 1.125rem);
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .parish-life-hero__image {
      object-position: var(--parish-life-hero-position-desktop);
    }
  }
</style>
