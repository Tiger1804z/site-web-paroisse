---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import interiorImage from '@/assets/images/paroisse/autel-fleurs-blanches-01.jpg';
import artImage from '@/assets/images/paroisse/chemin-de-croix-01.webp';
import crossImage from '@/assets/images/paroisse/croix-verre-entree-01.webp';
import gardenImage from '@/assets/images/paroisse/eglise-exterieur-jardin-01.webp';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface ParishGroup {
  name: string;
  description: string;
  image: ImageMetadata;
  objectPosition: string;
}

const groups = [
  {
    name: 'Jeunes',
    description: 'Activités et rassemblements pour la jeunesse',
    image: crossImage,
    objectPosition: 'center',
  },
  {
    name: 'Chorale',
    description: 'Chant liturgique et animation des célébrations',
    image: interiorImage,
    objectPosition: 'center',
  },
  {
    name: 'Dames et Fils de Notre-Dame',
    description: 'Dévotion mariale et entraide communautaire',
    image: gardenImage,
    objectPosition: 'center',
  },
  {
    name: 'Marguilliers',
    description: 'Conseil de fabrique et gouvernance paroissiale',
    image: artImage,
    objectPosition: 'center',
  },
] as const satisfies readonly ParishGroup[];
---

<section class="parish-life section-block" aria-labelledby="parish-life-title">
  <Container>
    <div class="parish-life__heading" data-motion-reveal>
      <Eyebrow>Communauté</Eyebrow>
      <h2 id="parish-life-title" class="type-h2">Vivre la paroisse</h2>
    </div>

    <div class="parish-life__grid" data-motion-stagger>
      {
        groups.map((group) => (
          <a
            class="parish-group"
            href="/vie-paroissiale"
            aria-label={`Découvrir le groupe ${group.name}; photographie architecturale d’illustration`}
            data-motion-item
          >
            <Image
              src={group.image}
              alt=""
              widths={[240, 420, 640]}
              sizes="(min-width: 48rem) 25vw, 50vw"
              loading="lazy"
              style={`object-position: ${group.objectPosition}`}
            />
            <span class="parish-group__overlay" aria-hidden="true" />
            <span class="parish-group__copy">
              <span class="parish-group__title">{group.name}</span>
              <span class="parish-group__description">{group.description}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="parish-life__action" data-motion-reveal>
      <Button href="/vie-paroissiale">Découvrir nos groupes</Button>
    </div>
  </Container>
</section>

<style>
  .parish-life {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }

  .parish-life__heading {
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .parish-life__heading :global(.ui-eyebrow) {
    color: var(--color-wood);
  }

  .parish-life h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
  }

  .parish-life__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .parish-group {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-charcoal);
    color: var(--color-ivory);
    text-decoration: none;
  }

  .parish-group > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition:
      scale var(--duration-media) var(--ease-editorial),
      opacity var(--duration-media) var(--ease-editorial);
  }

  .parish-group:hover > :global(img) {
    scale: var(--motion-scale-hover);
    opacity: 0.9;
  }

  .parish-group__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-charcoal) 88%, transparent),
      transparent 68%
    );
  }

  .parish-group__copy {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.25rem;
    padding: 1rem;
  }

  .parish-group__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .parish-group__description {
    display: none;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .parish-life__action {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .parish-life__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .parish-group__description {
      display: block;
    }
  }

  @media (max-width: 24rem) {
    .parish-life__grid {
      gap: 0.75rem;
    }

    .parish-group__copy {
      padding: 0.75rem;
    }

    .parish-group__title {
      font-size: 1rem;
    }
  }
</style>
