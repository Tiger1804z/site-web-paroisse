---
import RemoteImage from '@/components/ui/RemoteImage.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { HomeParishLifeContent } from '@/types/homePage';

interface Props {
  content: HomeParishLifeContent;
}

const { content } = Astro.props;

// La numérotation suit la liste et se recalcule : retirer un groupe ne laisse
// pas un trou dans la série.
const groups = content.groups.map((group, index) => ({
  ...group,
  number: String(index + 1).padStart(2, '0'),
}));
---

<section
  id="vivre-la-paroisse"
  class="parish-life section-block"
  aria-labelledby="parish-life-title"
>
  {
    content.image && (
      <div class="parish-life__media" aria-hidden="true">
        <RemoteImage image={content.image} alt="" sizes="100vw" />
      </div>
    )
  }
  <div class="parish-life__overlay" aria-hidden="true"></div>

  <Container class="parish-life__container">
    <div class="parish-life__layout">
      <div class="parish-life__heading" data-motion-reveal>
        <Eyebrow tone="light">{content.eyebrow}</Eyebrow>
        <h2 id="parish-life-title" class="type-h2">{content.title}</h2>
        <p>{content.introduction}</p>
      </div>

      <ol class="parish-life__list" data-motion-stagger>
        {
          groups.map((group) => (
            <li data-motion-item>
              <a class="parish-group" href="/vie-paroissiale">
                <span class="parish-group__number" aria-hidden="true">
                  {group.number}
                </span>
                <span class="parish-group__copy">
                  <span class="parish-group__title">{group.name}</span>
                  <span class="parish-group__description">{group.teaser}</span>
                </span>
                <span class="parish-group__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="parish-life__action" data-motion-reveal>
      <Button href="/vie-paroissiale" variant="light">
        {content.ctaLabel}
      </Button>
    </div>
  </Container>
</section>

<style>
  .parish-life {
    position: relative;
    overflow: hidden;
    min-height: clamp(48rem, 78vw, 58rem);
    background: var(--color-burgundy-dark);
    color: var(--color-ivory);
  }

  .parish-life__media,
  .parish-life__overlay {
    position: absolute;
    inset: 0;
  }

  .parish-life__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 34%;
    scale: 1.01;
  }

  .parish-life__overlay {
    background:
      linear-gradient(
        90deg,
        rgb(31 11 18 / 94%) 0%,
        rgb(46 16 25 / 84%) 43%,
        rgb(28 25 24 / 66%) 100%
      ),
      linear-gradient(0deg, rgb(28 25 24 / 62%), transparent 48%);
  }

  .parish-life__container {
    position: relative;
    z-index: 1;
  }

  .parish-life__layout {
    display: grid;
    gap: 3rem;
  }

  .parish-life__heading {
    max-width: 34rem;
  }

  .parish-life h2 {
    margin: 0.75rem 0 0;
    color: var(--color-ivory);
  }

  .parish-life__heading > p {
    max-width: 30rem;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 76%, transparent);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .parish-life__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(245 243 238 / 22%);
    list-style: none;
  }

  .parish-group {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 7.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid rgb(245 243 238 / 22%);
    color: var(--color-ivory);
    text-decoration: none;
    transition:
      background-color var(--duration-short) var(--ease-editorial),
      padding-inline var(--duration-short) var(--ease-editorial);
  }

  .parish-group:hover {
    padding-inline: 0.75rem;
    background: rgb(245 243 238 / 7%);
  }

  .parish-group__number {
    color: var(--color-gold);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .parish-group__copy {
    display: grid;
    gap: 0.4rem;
  }

  .parish-group__title {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1.3rem + 0.8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .parish-group__description {
    color: color-mix(in srgb, var(--color-ivory) 72%, transparent);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .parish-group__arrow {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 1.5rem;
    transition: translate var(--duration-short) var(--ease-editorial);
  }

  .parish-group:hover .parish-group__arrow {
    translate: 0.25rem;
  }

  .parish-life__action {
    margin-top: 3rem;
  }

  :global(.motion-enabled)
    .parish-life__list[data-motion-stagger]
    > [data-motion-item] {
    transition-duration: 480ms;
    transition-timing-function: var(--motion-ease-emphasized);
  }

  :global(.motion-enabled)
    .parish-life__list[data-motion-stagger]:not([data-motion-visible])
    > [data-motion-item] {
    transform: translate3d(0, 0.875rem, 0);
  }

  @media (min-width: 64rem) {
    .parish-life__layout {
      grid-template-columns: minmax(19rem, 0.78fr) minmax(30rem, 1.22fr);
      align-items: start;
      gap: clamp(4rem, 7vw, 8rem);
    }

    .parish-life__heading {
      position: sticky;
      top: calc(var(--header-height) + 3rem);
    }
  }

  @media (max-width: 47.99rem) {
    .parish-life {
      min-height: 0;
    }

    .parish-life__media :global(img) {
      object-position: 56% center;
    }

    .parish-life__overlay {
      background:
        linear-gradient(
          to bottom,
          rgb(31 11 18 / 88%),
          rgb(46 16 25 / 86%) 55%,
          rgb(28 25 24 / 92%)
        ),
        linear-gradient(90deg, rgb(28 25 24 / 30%), transparent);
    }

    .parish-group {
      min-height: 6.5rem;
    }
  }

  @media (max-width: 23rem) {
    .parish-group {
      grid-template-columns: 1.75rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .parish-group__description {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parish-group,
    .parish-group__arrow {
      transition: none;
    }
  }
</style>
