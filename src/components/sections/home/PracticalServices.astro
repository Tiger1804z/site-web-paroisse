---
import churchImage from '@/assets/images/home/editorial/church-facade-editorial.jpg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import EditorialImageFrame from '@/components/ui/EditorialImageFrame.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { HomeServicesContent } from '@/types/homePage';

interface Props {
  content: HomeServicesContent;
}

const { content } = Astro.props;
---

<section
  class="practical-services section-block"
  aria-labelledby="practical-services-title"
>
  <Container>
    <div class="practical-services__layout">
      <div class="practical-services__copy" data-motion-reveal>
        <Eyebrow>{content.eyebrow}</Eyebrow>
        <h2 id="practical-services-title" class="type-h2">{content.title}</h2>
        <p>{content.introduction}</p>

        <ul class="practical-services__links">
          {
            content.links.map((item) => (
              <li>
                <a href={item.href}>
                  <span>{item.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>

        <Button href="/nos-services/">{content.ctaLabel}</Button>
      </div>

      <div class="practical-services__visual" data-motion-reveal>
        <EditorialImageFrame
          image={churchImage}
          alt="Détail architectural de la façade de Santa Maria del Fiore à Florence, utilisé comme illustration"
          variant="arch"
          objectPosition="49% center"
          widths={[400, 600, 800, 1000]}
          sizes="(min-width: 64rem) 34vw, 80vw"
        />
        <span class="practical-services__visual-note">
          {content.visualNote}
        </span>
      </div>

      <a class="practical-services__thrift" href="/friperie/">
        <span class="practical-services__thrift-index" aria-hidden="true">
          {content.thrift.eyebrow}
        </span>
        <span class="practical-services__thrift-title">
          {content.thrift.title}
        </span>
        <span class="practical-services__thrift-copy">
          {content.thrift.description}
        </span>
        <span class="practical-services__thrift-link">
          {content.thrift.linkLabel}
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </Container>
</section>

<style>
  .practical-services {
    overflow: hidden;
    background: var(--color-ivory);
  }

  .practical-services__layout {
    display: grid;
    gap: 2.5rem;
  }

  .practical-services__copy {
    max-width: 41rem;
  }

  .practical-services h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
  }

  .practical-services__copy > p {
    max-width: 37rem;
    margin: 1.5rem 0 2rem;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .practical-services__links {
    margin: 0 0 2.5rem;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 32%, transparent);
    list-style: none;
  }

  .practical-services__links a {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 24%, transparent);
    color: var(--color-charcoal);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--duration-short) var(--ease-editorial),
      padding-inline var(--duration-short) var(--ease-editorial);
  }

  .practical-services__links a:hover {
    padding-inline: 0.5rem;
    color: var(--color-burgundy);
  }

  .practical-services__links a > span:last-child {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .practical-services__visual {
    position: relative;
    width: min(100%, 29rem);
    margin-inline: auto;
  }

  .practical-services__visual::after {
    position: absolute;
    z-index: -1;
    inset: 2rem -1.5rem -1.5rem 2rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 40%, transparent);
    content: '';
  }

  .practical-services__visual-note {
    display: block;
    margin-top: 1rem;
    color: var(--color-wood);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-align: right;
    text-transform: uppercase;
  }

  .practical-services__thrift {
    position: relative;
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 2rem;
    background:
      radial-gradient(
        circle at 90% 10%,
        color-mix(in srgb, var(--color-gold) 14%, transparent),
        transparent 13rem
      ),
      var(--color-charcoal);
    color: var(--color-ivory);
    text-decoration: none;
  }

  .practical-services__thrift::before {
    position: absolute;
    top: -4rem;
    right: -4rem;
    width: 11rem;
    height: 11rem;
    border: 1px solid rgb(170 139 82 / 26%);
    border-radius: 50%;
    content: '';
  }

  .practical-services__thrift-index {
    margin-bottom: auto;
    color: var(--color-gold);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .practical-services__thrift-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.75rem + 1vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .practical-services__thrift-copy {
    max-width: 27rem;
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
    line-height: 1.65;
  }

  .practical-services__thrift-link {
    margin-top: 1.5rem;
    color: var(--color-gold);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .practical-services__thrift-link > span {
    display: inline-block;
    margin-left: 0.35rem;
    transition: translate var(--duration-short) var(--ease-editorial);
  }

  .practical-services__thrift:hover .practical-services__thrift-link > span {
    translate: 0.25rem;
  }

  @media (min-width: 48rem) {
    .practical-services__layout {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
      align-items: center;
      gap: 4rem;
    }

    .practical-services__thrift {
      grid-column: 1 / -1;
      min-height: 16rem;
      padding: 2.5rem;
    }
  }

  @media (min-width: 75rem) {
    .practical-services__layout {
      grid-template-columns: minmax(25rem, 1.08fr) minmax(19rem, 0.76fr) minmax(
          16rem,
          0.58fr
        );
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }

    .practical-services__thrift {
      grid-column: auto;
      min-height: 31rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .practical-services__links a,
    .practical-services__thrift-link > span {
      transition: none;
    }
  }
</style>
