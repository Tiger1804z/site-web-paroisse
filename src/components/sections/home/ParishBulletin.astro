---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

const documentLines = Array.from({ length: 8 });
---

<section
  class="parish-bulletin section-block"
  aria-labelledby="parish-bulletin-title"
>
  <div class="parish-bulletin__arch parish-bulletin__arch--large"></div>
  <div class="parish-bulletin__arch parish-bulletin__arch--small"></div>

  <Container>
    <div class="parish-bulletin__grid">
      <div class="parish-bulletin__copy">
        <Eyebrow tone="light">Restez informé</Eyebrow>
        <h2 id="parish-bulletin-title" class="type-h2">
          Le feuillet<br />de la semaine
        </h2>
        <p class="type-body">
          Consultez les annonces, les intentions de messe et les actualités de
          la paroisse dans le feuillet hebdomadaire.
        </p>

        <div class="parish-bulletin__current">
          <p>Feuillet paroissial</p>
          <h3>Semaine du [DATE]</h3>
          <span>Document à confirmer</span>
        </div>

        <div class="parish-bulletin__actions">
          <Button
            href="/feuillets-paroissiaux"
            variant="light"
            class="parish-bulletin__primary"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M6.75 3.75h7.5L18 7.5v12.75H6.75V3.75Z"
                stroke-linejoin="round"></path>
              <path d="M14.25 3.75V7.5H18" stroke-linejoin="round"></path>
            </svg>
            Consulter les feuillets
          </Button>
          <Button href="/feuillets-paroissiaux" variant="dark">
            Voir les anciens feuillets
          </Button>
        </div>
      </div>

      <div class="parish-bulletin__illustration" aria-hidden="true">
        <div class="parish-bulletin__document">
          <div class="parish-bulletin__document-heading">
            <span class="parish-bulletin__document-icon">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <span>
              <small>Paroisse</small>
              <strong>Saint-René-Goupil</strong>
            </span>
          </div>

          <div class="parish-bulletin__document-lines">
            {
              documentLines.map((_, index) => (
                <span
                  class:list={{
                    'is-short': index === 0 || index === 6,
                    'is-medium': index === 3,
                  }}
                />
              ))
            }
          </div>

          <div class="parish-bulletin__document-footer">
            <span>Semaine du [DATE]</span>
            <strong>PDF</strong>
          </div>
        </div>
        <div class="parish-bulletin__document-shadow"></div>
      </div>
    </div>
  </Container>
</section>

<style>
  .parish-bulletin {
    position: relative;
    overflow: hidden;
    background: var(--color-burgundy);
    color: var(--color-ivory);
  }

  .parish-bulletin__arch {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50%;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 6%, transparent);
    border-radius: 0 0 999px 999px;
    pointer-events: none;
  }

  .parish-bulletin__arch--large {
    width: min(37.5rem, 90vw);
    height: min(18.75rem, 45vw);
  }

  .parish-bulletin__arch--small {
    width: min(25rem, 65vw);
    height: min(12.5rem, 32.5vw);
  }

  .parish-bulletin__grid {
    position: relative;
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  .parish-bulletin__copy {
    max-width: 38rem;
  }

  .parish-bulletin h2 {
    margin: 1rem 0 0;
    color: var(--color-ivory);
  }

  .parish-bulletin__copy > .type-body {
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
  }

  .parish-bulletin__current {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 20%, transparent);
    background: color-mix(in srgb, var(--color-ivory) 10%, transparent);
  }

  .parish-bulletin__current p {
    margin: 0 0 0.75rem;
    color: var(--color-gold);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .parish-bulletin__current h3 {
    margin: 0;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .parish-bulletin__current span {
    display: block;
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--color-ivory) 60%, transparent);
    font-size: 0.875rem;
  }

  .parish-bulletin__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .parish-bulletin__actions :global(.parish-bulletin__primary) {
    background: var(--color-gold);
    color: var(--color-charcoal);
  }

  .parish-bulletin__actions :global(.parish-bulletin__primary:hover) {
    background: color-mix(in srgb, var(--color-gold) 88%, var(--color-ivory));
  }

  .parish-bulletin__illustration {
    position: relative;
    display: none;
    width: 17rem;
    height: 22rem;
    justify-self: center;
  }

  .parish-bulletin__document,
  .parish-bulletin__document-shadow {
    position: absolute;
    width: 16.25rem;
    height: 21.25rem;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 20%, transparent);
  }

  .parish-bulletin__document {
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--color-ivory) 10%, transparent);
    box-shadow: 0 1.5rem 3rem rgb(28 25 24 / 24%);
  }

  .parish-bulletin__document-shadow {
    right: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--color-ivory) 5%, transparent);
  }

  .parish-bulletin__document-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .parish-bulletin__document-icon {
    display: flex;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 30%, transparent);
    color: var(--color-gold);
  }

  .parish-bulletin__document-heading span:last-child {
    display: grid;
  }

  .parish-bulletin__document-heading small {
    color: color-mix(in srgb, var(--color-ivory) 55%, transparent);
    font-size: 0.625rem;
  }

  .parish-bulletin__document-heading strong {
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .parish-bulletin__document-lines {
    display: grid;
    gap: 0.5rem;
  }

  .parish-bulletin__document-lines span {
    width: 100%;
    height: 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ivory) 20%, transparent);
  }

  .parish-bulletin__document-lines .is-short {
    width: 75%;
  }

  .parish-bulletin__document-lines .is-medium {
    width: 50%;
  }

  .parish-bulletin__document-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-ivory) 20%, transparent);
    color: color-mix(in srgb, var(--color-ivory) 55%, transparent);
    font-size: 0.625rem;
  }

  .parish-bulletin__document-footer strong {
    color: var(--color-gold);
  }

  @media (min-width: 64rem) {
    .parish-bulletin__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .parish-bulletin__illustration {
      display: block;
    }
  }

  @media (max-width: 30rem) {
    .parish-bulletin__actions :global(.ui-button) {
      width: 100%;
    }
  }
</style>
