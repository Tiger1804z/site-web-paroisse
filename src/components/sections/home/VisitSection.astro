---
import RemoteImage from '@/components/ui/RemoteImage.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { HomeVisitContent } from '@/types/homePage';
import type { PublicContactDetails } from '@/types/siteSettings';

interface Props {
  content: HomeVisitContent;
  contact: PublicContactDetails;
}

const { content, contact } = Astro.props;
---

<section class="visit-section" aria-labelledby="visit-title">
  <Container>
    <div class="visit-section__layout">
      <div class="visit-section__content" data-motion-reveal>
        <Eyebrow>{content.eyebrow}</Eyebrow>
        <h2 id="visit-title">{content.title}</h2>
        <p class="visit-section__introduction">{content.introduction}</p>

        <address class="visit-section__address">
          <span class="visit-section__organization">
            {contact.organizationName}
          </span>
          <span>{contact.address.street}</span>
          <span>
            {contact.address.city}, {contact.address.province}{' '}
            {contact.address.postalCode}
          </span>
          <span class="visit-section__phone">{contact.phone.display}</span>
        </address>

        <div class="visit-section__actions">
          <Button href="/contact/" variant="light">
            {content.contactCtaLabel}
          </Button>
          <Button
            href={contact.directionsUrl}
            variant="secondary"
            target="_blank"
          >
            {content.directionsCtaLabel}
          </Button>
        </div>
      </div>

      {
        content.image && (
          <figure class="visit-section__visual" data-motion-reveal>
            <RemoteImage
              image={content.image}
              sizes="(min-width: 64rem) 48vw, 100vw"
            />
            <figcaption>
              {contact.address.street}, {contact.address.city}
            </figcaption>
          </figure>
        )
      }
    </div>
  </Container>
</section>

<style>
  .visit-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 9vw, 8.5rem);
    background: var(--color-burgundy-dark);
    color: var(--color-ivory);
    isolation: isolate;
  }

  .visit-section::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 20% 20%,
        color-mix(in srgb, var(--color-gold) 12%, transparent),
        transparent 34%
      ),
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--color-charcoal) 38%, transparent),
        transparent 60%
      );
    content: '';
  }

  .visit-section__layout {
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .visit-section__content {
    max-width: 36rem;
  }

  .visit-section__content :global(.ui-eyebrow) {
    color: var(--color-gold);
  }

  .visit-section h2 {
    max-width: 11ch;
    margin: 0.75rem 0 0;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.2vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .visit-section__introduction {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 74%, transparent);
    font-size: var(--font-size-body-lg);
    line-height: 1.75;
  }

  .visit-section__address {
    display: grid;
    gap: 0.3rem;
    margin-top: 2.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-gold) 65%, transparent);
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
    font-size: var(--font-size-ui);
    font-style: normal;
    line-height: 1.55;
  }

  .visit-section__organization {
    margin-bottom: 0.35rem;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
  }

  /* Numéro affiché, jamais cliquable : pas de soulignement qui promettrait un
     appel d'un seul geste. Le reste de la présentation ne bouge pas. */
  .visit-section__phone {
    width: fit-content;
    margin-top: 0.55rem;
    color: var(--color-gold-light);
    font-size: 1.12rem;
    font-weight: 650;
  }

  .visit-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.25rem;
  }

  .visit-section__actions :global(.ui-button--secondary) {
    border-color: color-mix(in srgb, var(--color-ivory) 58%, transparent);
    color: var(--color-ivory);
  }

  .visit-section__visual {
    position: relative;
    max-width: 39rem;
    margin: 0;
    padding: clamp(0.75rem, 1.8vw, 1.25rem);
    border: 1px solid color-mix(in srgb, var(--color-gold) 32%, transparent);
  }

  .visit-section__visual::before {
    position: absolute;
    z-index: -1;
    inset: 1.5rem -1.5rem -1.5rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 22%, transparent);
    content: '';
  }

  .visit-section__visual :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 54%;
    filter: saturate(0.78) contrast(1.04) brightness(0.86);
  }

  .visit-section__visual figcaption {
    margin-top: 0.8rem;
    color: color-mix(in srgb, var(--color-ivory) 58%, transparent);
    font-size: var(--font-size-meta);
  }

  @media (min-width: 64rem) {
    .visit-section__layout {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    }

    .visit-section__visual {
      justify-self: end;
    }
  }

  @media (max-width: 30rem) {
    .visit-section__actions :global(.ui-button) {
      width: 100%;
    }

    .visit-section__visual::before {
      inset: 0.85rem -0.65rem -0.65rem 0.85rem;
    }
  }
</style>
