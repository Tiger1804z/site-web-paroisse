---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface VisitDetail {
  label: string;
  value: string;
  iconPath: string;
}

const details = [
  {
    label: 'Adresse',
    value: '[ADRESSE]',
    iconPath:
      'M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm4.5 0C19.5 17.642 12 21.75 12 21.75S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z',
  },
  {
    label: 'Téléphone',
    value: '[TÉLÉPHONE]',
    iconPath:
      'M2.25 6.75c0 8.284 6.716 15 15 15h2.25A2.25 2.25 0 0 0 21.75 19.5v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z',
  },
  {
    label: 'Courriel',
    value: '[COURRIEL]',
    iconPath:
      'M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75',
  },
  {
    label: 'Stationnement',
    value: '[INFORMATION À CONFIRMER]',
    iconPath:
      'M8.25 18.75a1.5 1.5 0 1 1-3 0m3 0h6m-9 0H3.375A1.125 1.125 0 0 1 2.25 17.625V14.25m17.25 4.5a1.5 1.5 0 1 1-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25m2.25 11.177h-2.25m0-11.177v6.677h-12',
  },
] as const satisfies readonly VisitDetail[];
---

<section class="visit-section section-block" aria-labelledby="visit-title">
  <Container>
    <div class="visit-section__heading">
      <Eyebrow>Accueil</Eyebrow>
      <h2 id="visit-title" class="type-h2">Venez nous rencontrer</h2>
    </div>

    <div class="visit-section__grid">
      <div class="visit-section__details">
        {
          details.map((item) => (
            <div class="visit-detail">
              <span class="visit-detail__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    d={item.iconPath}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <h3>{item.label}</h3>
              <p>{item.value}</p>
            </div>
          ))
        }

        <div class="visit-detail visit-detail--office">
          <h3>Horaires du secrétariat</h3>
          <p>[HEURES DU SECRÉTARIAT]</p>
          <div class="visit-detail__actions">
            <Button href="/contact">Nous joindre</Button>
            <Button href="/premiere-visite" variant="secondary">
              Première visite
            </Button>
          </div>
        </div>
      </div>

      <div
        class="visit-section__map"
        role="img"
        aria-label="Emplacement réservé à un futur plan d’accès; aucune carte externe n’est chargée"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="40"
          height="40"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <path
            d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p>Paroisse Saint-René-Goupil</p>
        <span>[ADRESSE]</span>
      </div>
    </div>
  </Container>
</section>

<style>
  .visit-section {
    background: var(--color-ivory);
  }

  .visit-section__heading {
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .visit-section__heading :global(.ui-eyebrow) {
    color: var(--color-wood);
  }

  .visit-section h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
  }

  .visit-section__grid {
    display: grid;
    align-items: start;
    gap: 3rem;
  }

  .visit-section__details {
    display: grid;
    gap: 1.5rem;
  }

  .visit-detail {
    padding: 1.5rem;
    background: var(--color-paper);
  }

  .visit-detail__icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    background: color-mix(in srgb, var(--color-burgundy) 10%, transparent);
    color: var(--color-burgundy);
  }

  .visit-detail h3 {
    margin: 0;
    color: var(--color-wood);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .visit-detail p {
    margin: 0.5rem 0 0;
    color: var(--color-charcoal);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .visit-detail--office {
    grid-column: 1 / -1;
  }

  .visit-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .visit-section__map {
    display: flex;
    min-height: 26.25rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    color: color-mix(in srgb, var(--color-gold) 70%, transparent);
    text-align: center;
  }

  .visit-section__map p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .visit-section__map span {
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--color-muted) 72%, transparent);
    font-size: 0.75rem;
  }

  @media (min-width: 40rem) {
    .visit-section__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .visit-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .visit-detail__actions :global(.ui-button) {
      width: 100%;
    }
  }
</style>
