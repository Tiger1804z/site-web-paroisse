---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import floralImage from '@/assets/images/paroisse/autel-fleurs-blanches-01.jpg';
import crossImage from '@/assets/images/paroisse/croix-verre-entree-01.webp';
import redImage from '@/assets/images/paroisse/decor-rouge-devant-autel-01.jpg';
import featuredImage from '@/assets/images/paroisse/eglise-exterieur-clochers-01.webp';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import TextLink from '@/components/ui/TextLink.astro';

interface EventItem {
  category: string;
  date: string;
  title: string;
  description: string;
  location: string;
  image: ImageMetadata;
  imageAlt: string;
}

const events = [
  {
    category: 'Concerts',
    date: '[DATE]',
    title: 'Concert à l’église',
    description:
      'Une soirée musicale en l’honneur de notre communauté, avec des artistes locaux.',
    location: '[INFORMATION À CONFIRMER]',
    image: featuredImage,
    imageAlt:
      'Vue extérieure de l’église et de ses structures portant des cloches; photographie d’illustration',
  },
  {
    category: 'Activités communautaires',
    date: '[DATE]',
    title: 'Souper dansant de l’Âge d’Or',
    description: 'Une belle soirée pour célébrer ensemble.',
    location: '[INFORMATION À CONFIRMER]',
    image: floralImage,
    imageAlt: '',
  },
  {
    category: 'Pèlerinages',
    date: '[DATE]',
    title: 'Pèlerinage annuel',
    description: 'Cheminement spirituel en communauté.',
    location: '[INFORMATION À CONFIRMER]',
    image: crossImage,
    imageAlt: '',
  },
  {
    category: 'Célébrations',
    date: '[DATE]',
    title: 'Célébration spéciale',
    description: 'Moment de recueillement et de rencontre.',
    location: '[INFORMATION À CONFIRMER]',
    image: redImage,
    imageAlt: '',
  },
] as const satisfies readonly EventItem[];

const [featuredEvent, ...secondaryEvents] = events;
---

<section
  class="upcoming-events section-block"
  aria-labelledby="upcoming-events-title"
>
  <Container>
    <div class="upcoming-events__heading" data-motion-reveal>
      <div>
        <Eyebrow>Vie communautaire</Eyebrow>
        <h2 id="upcoming-events-title" class="type-h2">Prochaines activités</h2>
      </div>
      <TextLink href="/evenements">Voir tous les événements</TextLink>
    </div>

    <div class="upcoming-events__grid">
      <article
        class="featured-event"
        data-motion-reveal
        data-motion-variant="image"
      >
        <Image
          src={featuredEvent.image}
          alt={featuredEvent.imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 64rem) calc(100vw - 31rem), calc(100vw - 2.5rem)"
          loading="lazy"
        />
        <div class="featured-event__overlay" aria-hidden="true"></div>
        <div class="featured-event__content">
          <p class="featured-event__category">{featuredEvent.category}</p>
          <h3>{featuredEvent.title}</h3>
          <p class="featured-event__description">
            {featuredEvent.description}
          </p>
          <p class="featured-event__meta">
            <span>{featuredEvent.date}</span>
            <span aria-hidden="true">·</span>
            <span>{featuredEvent.location}</span>
          </p>
          <Button href="/evenements" variant="dark">Voir les détails</Button>
        </div>
      </article>

      <div class="secondary-events" data-motion-stagger>
        {
          secondaryEvents.map((event) => (
            <a
              class="secondary-event"
              href="/evenements"
              aria-label={`Voir les détails de l’activité temporaire « ${event.title} »`}
              data-motion-item
            >
              <span class="secondary-event__image" aria-hidden="true">
                <Image
                  src={event.image}
                  alt={event.imageAlt}
                  widths={[160]}
                  sizes="80px"
                  loading="lazy"
                />
              </span>
              <span class="secondary-event__copy">
                <span class="secondary-event__category">{event.category}</span>
                <span class="secondary-event__title">{event.title}</span>
                <span class="secondary-event__meta">
                  {event.date} · {event.location}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .upcoming-events {
    background: var(--color-ivory);
  }

  .upcoming-events__heading {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .upcoming-events__heading h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
  }

  .upcoming-events__heading :global(.ui-text-link) {
    align-self: flex-start;
  }

  .upcoming-events__grid {
    display: grid;
    gap: 1.5rem;
  }

  .featured-event {
    position: relative;
    min-height: 34rem;
    overflow: hidden;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .featured-event > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition:
      scale var(--duration-media) var(--ease-editorial),
      opacity var(--duration-media) var(--ease-editorial);
  }

  .featured-event:hover > :global(img) {
    scale: var(--motion-scale-hover);
    opacity: 0.8;
  }

  .featured-event__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-charcoal),
      color-mix(in srgb, var(--color-charcoal) 30%, transparent),
      transparent
    );
  }

  .featured-event__content {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 2rem;
  }

  .featured-event__category,
  .secondary-event__category {
    color: var(--color-gold);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .featured-event__category {
    margin: 0 0 0.5rem;
  }

  .featured-event h3 {
    margin: 0;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .featured-event__description {
    max-width: 36rem;
    margin: 0.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 72%, transparent);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .featured-event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0 1.25rem;
    color: color-mix(in srgb, var(--color-ivory) 65%, transparent);
    font-size: 0.875rem;
  }

  .secondary-events {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .secondary-event {
    display: flex;
    min-height: 7rem;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-paper);
    color: var(--color-charcoal);
    text-decoration: none;
    transition: background-color var(--duration-short) var(--ease-editorial);
  }

  .secondary-event:hover {
    background: color-mix(
      in srgb,
      var(--color-paper) 82%,
      var(--color-surface)
    );
  }

  .secondary-event__image {
    width: 5rem;
    height: 5rem;
    flex: 0 0 auto;
    overflow: hidden;
  }

  .secondary-event__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-editorial);
  }

  .secondary-event:hover .secondary-event__image :global(img) {
    scale: var(--motion-scale-hover);
  }

  .secondary-event__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .secondary-event__category {
    letter-spacing: 0.15em;
  }

  .secondary-event__title {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.15;
  }

  .secondary-event__meta {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .upcoming-events__heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .featured-event {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 64rem) {
    .upcoming-events__grid {
      grid-template-columns: minmax(0, 1fr) 21.25rem;
      gap: 2rem;
    }
  }
</style>
