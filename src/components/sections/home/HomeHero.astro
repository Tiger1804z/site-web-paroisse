---
import RemoteImage from '@/components/ui/RemoteImage.astro';
import AmbientHero from '@/components/motion/AmbientHero.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import {
  formatTimeLabel,
  WEEKDAY_LABELS,
} from '@/lib/schedules/schedule-format.ts';
import type { HomeHeroContent } from '@/types/homePage';
import type { WeeklyMassEntry } from '@/types/schedule';

interface Props {
  content: HomeHeroContent;
  masses?: readonly WeeklyMassEntry[];
}

const { content, masses = [] } = Astro.props;

// Rendu serveur : l'horaire hebdomadaire complet, sans prétendre calculer la
// prochaine messe. Le script client remplace ensuite liste et titre.
const scheduleRows = masses.map((mass) => ({
  id: mass.id,
  dayLabel: WEEKDAY_LABELS[mass.weekday],
  timeLabel: formatTimeLabel(mass.time) ?? mass.time,
}));

// `</script>` ne peut pas surgir d'un titre saisi dans Sanity et rompre le bloc.
const massesPayload = JSON.stringify(masses).replaceAll('<', '\\u003c');

const heroSlides = content.slides;

const lensClipId = 'home-hero-organic-lens-clip';
---

<section
  class="home-hero"
  aria-labelledby="home-hero-title"
  data-home-hero
  data-lens-active="false"
>
  <div class="home-hero__media">
    {
      heroSlides.map((slide, index) => (
        <div
          class="home-hero__slide"
          data-hero-slide
          data-active={index === 0 ? 'true' : 'false'}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <RemoteImage
            image={slide.image}
            sizes="100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
          />
        </div>
      ))
    }
  </div>

  <svg
    class="home-hero__lens-definition"
    width="100%"
    height="100%"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <clipPath id={lensClipId} clipPathUnits="userSpaceOnUse">
        <path data-organic-lens-clip-path></path>
      </clipPath>
    </defs>
  </svg>

  <div class="home-hero__overlay" aria-hidden="true"></div>

  <div
    class="home-hero__reveals"
    aria-hidden="true"
    style={`clip-path: url(#${lensClipId}); -webkit-clip-path: url(#${lensClipId});`}
  >
    {
      heroSlides.map((slide, index) => (
        <div
          class="home-hero__reveal"
          data-organic-lens-layer
          data-active={index === 1 ? 'true' : 'false'}
        >
          <RemoteImage
            image={slide.image}
            alt=""
            sizes="100vw"
            data-organic-lens-image
          />
        </div>
      ))
    }
  </div>

  <svg
    class="home-hero__lens-outline"
    width="100%"
    height="100%"
    aria-hidden="true"
    focusable="false"
  >
    <path class="home-hero__lens-outline-path" data-organic-lens-outline-path
    ></path>
  </svg>
  <span
    class="home-hero__lens-metric"
    data-organic-lens-metric
    aria-hidden="true"></span>

  <AmbientHero class="home-hero__ambient" particles={7} />
  <div class="home-hero__beams" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <Container class="home-hero__content">
    <div class="home-hero__copy">
      <p class="type-script-accent home-hero__script">{content.script}</p>
      {
        /*
        Une ligne de titre par entrée, séparées par un retour à la ligne. Le
        Studio ne saisit jamais de HTML : les coupures typographiques passent
        par la structure, pas par du balisage collé dans une chaîne.
      */
      }
      <h1 id="home-hero-title" class="type-display-xl">
        {
          content.titleLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
      <p class="type-body-large home-hero__introduction">
        {content.introduction}
      </p>
      <div class="home-hero__actions">
        <Button href="/horaires" variant="light">
          {content.primaryCtaLabel}
        </Button>
        <Button href="/notre-paroisse" variant="dark">
          {content.secondaryCtaLabel}
        </Button>
      </div>
    </div>
  </Container>

  <aside
    class="home-hero__schedule"
    aria-labelledby="hero-schedule-title"
    data-upcoming-masses
  >
    <p
      id="hero-schedule-title"
      class="home-hero__schedule-label"
      data-upcoming-masses-title
    >
      {content.scheduleTitle}
    </p>
    {
      scheduleRows.length > 0 ? (
        <dl class="home-hero__schedule-list" data-upcoming-masses-list>
          {scheduleRows.map((row) => (
            <div>
              <dt>{row.dayLabel}</dt>
              <dd>{row.timeLabel}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="home-hero__schedule-empty">Horaires à confirmer.</p>
      )
    }
    <a class="home-hero__schedule-link" href="/horaires">
      {content.scheduleLinkLabel}
      <span aria-hidden="true">→</span>
    </a>
    <p class="home-hero__schedule-note">{content.scheduleNote}</p>
    {
      scheduleRows.length > 0 && (
        <script
          is:inline
          type="application/json"
          data-upcoming-masses-data
          set:html={massesPayload}
        />
      )
    }
  </aside>

  <div
    class="home-hero__indicators"
    role="group"
    aria-label="Choisir l’image du hero"
  >
    {
      heroSlides.map((slide, index) => (
        <button
          type="button"
          aria-label={`Afficher l’image ${index + 1} sur ${heroSlides.length} : ${slide.label}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-hero-indicator
        >
          <span aria-hidden="true" />
        </button>
      ))
    }
  </div>

  <a
    class="home-hero__scroll"
    href="#annonce-importante"
    aria-label="Faire défiler vers l’annonce importante"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="m19 9-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"
      ></path>
    </svg>
  </a>
</section>

<script>
  import { initializeHeroSlideshow } from '@/scripts/hero-slideshow';
  import { initializeOrganicHeroLens } from '@/scripts/organic-hero-lens';
  import { initializeUpcomingMassesCards } from '@/scripts/upcoming-masses-card';

  initializeUpcomingMassesCards();

  document.querySelectorAll<HTMLElement>('[data-home-hero]').forEach((hero) => {
    if (hero.dataset.initialized === 'true') return;
    hero.dataset.initialized = 'true';

    const slideCount = hero.querySelectorAll('[data-hero-slide]').length;
    const lensController = initializeOrganicHeroLens(hero, {
      cycleOnMovement: false,
      initialImageIndex: 1,
    });

    initializeHeroSlideshow(hero, {
      // La loupe montre toujours l'image suivante, jamais celle déjà affichée.
      onSelect: (index) =>
        lensController?.setActiveImage((index + 1) % slideCount),
    });
  });
</script>

<style>
  .home-hero {
    --lens-size: clamp(9.375rem, 15vw, 15.625rem);

    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    contain: paint;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .home-hero__media,
  .home-hero__slide {
    position: absolute;
    inset: 0;
  }

  .home-hero__slide {
    opacity: 0;
    transition: opacity 1250ms var(--motion-ease-cinematic);
  }

  .home-hero__slide[data-active='true'] {
    z-index: 1;
    opacity: 1;
  }

  .home-hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.93) contrast(1.055) saturate(0.88) sepia(0.035);
  }

  .home-hero__slide[data-active='true'] :global(img) {
    animation: home-hero-zoom var(--motion-duration-cinematic)
      var(--motion-ease-cinematic) both;
  }

  .home-hero__lens-definition,
  .home-hero__reveals,
  .home-hero__reveal,
  .home-hero__lens-outline {
    position: absolute;
    inset: 0;
  }

  .home-hero__lens-definition {
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }

  .home-hero__reveals {
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms var(--motion-ease-standard);
    will-change: opacity;
  }

  .home-hero[data-lens-active='true'] .home-hero__reveals {
    opacity: 1;
  }

  .home-hero__reveal {
    opacity: 0;
    transition: opacity 360ms var(--motion-ease-standard);
  }

  .home-hero__reveal[data-active='true'] {
    opacity: 1;
  }

  .home-hero__reveal :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.93) contrast(1.055) saturate(0.88) sepia(0.035);
  }

  .home-hero__lens-outline {
    z-index: 3;
    display: none;
    opacity: 0;
    overflow: visible;
    pointer-events: none;
    transition: opacity 160ms var(--motion-ease-standard);
  }

  .home-hero__lens-outline-path {
    fill: none;
    stroke: rgb(245 243 238 / 24%);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0.85rem 1.25rem rgb(28 25 24 / 16%));
  }

  .home-hero[data-lens-active='true'] .home-hero__lens-outline {
    opacity: 1;
  }

  .home-hero__lens-metric {
    position: absolute;
    width: var(--lens-size);
    height: 1px;
    visibility: hidden;
    pointer-events: none;
  }

  @keyframes home-hero-zoom {
    from {
      scale: 1;
    }

    to {
      scale: 1.022;
    }
  }

  :global(.home-hero__ambient) {
    z-index: 3;
  }

  .home-hero__overlay {
    position: absolute;
    z-index: 2;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(28 25 24 / 76%) 0%,
        rgb(28 25 24 / 55%) 44%,
        rgb(28 25 24 / 23%) 78%,
        rgb(28 25 24 / 17%) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(28 25 24 / 39%),
        rgb(28 25 24 / 14%) 48%,
        rgb(28 25 24 / 62%)
      );
  }

  .home-hero__beams {
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .home-hero__beams span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-ivory) 8%, transparent),
      transparent
    );
  }

  .home-hero__beams span:nth-child(2) {
    left: 48%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-gold) 5%, transparent),
      transparent
    );
  }

  .home-hero__beams span:nth-child(3) {
    left: 52%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-gold) 5%, transparent),
      transparent
    );
  }

  .home-hero__content {
    position: relative;
    z-index: 4;
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding-block: calc(var(--header-height) + 2.5rem) 8rem;
  }

  .home-hero__copy {
    max-width: 42.5rem;
  }

  .home-hero__script {
    margin: 0 0 0.75rem;
    color: color-mix(in srgb, var(--color-ivory) 72%, transparent);
  }

  .home-hero h1 {
    margin: 0;
    color: var(--color-ivory);
  }

  .home-hero__introduction {
    max-width: 32.5rem;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .home-hero__schedule {
    position: absolute;
    z-index: 5;
    right: var(--gutter-page);
    bottom: 3rem;
    display: none;
    width: 16.25rem;
    padding: 1.625rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 34%, transparent);
    background:
      linear-gradient(rgb(255 255 255 / 2%), transparent),
      color-mix(in srgb, var(--color-burgundy-dark) 94%, var(--color-charcoal));
    color: var(--color-ivory);
    box-shadow: 0 1.25rem 3.5rem rgb(12 8 9 / 32%);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .home-hero__schedule-label {
    margin: 0 0 1rem;
    color: color-mix(in srgb, var(--color-gold) 88%, var(--color-ivory));
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero__schedule-list {
    margin: 0;
  }

  .home-hero__schedule-list div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ivory) 14%, transparent);
  }

  .home-hero__schedule-list div:first-child {
    padding-top: 0;
  }

  .home-hero__schedule-list div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .home-hero__schedule-list dt {
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .home-hero__schedule-list dd {
    margin: 0;
    color: color-mix(in srgb, var(--color-rose) 76%, var(--color-ivory));
    font-size: var(--font-size-ui);
    font-weight: 700;
  }

  .home-hero__schedule-empty {
    margin: 0;
    color: color-mix(in srgb, var(--color-ivory) 78%, transparent);
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .home-hero__schedule-link {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--color-gold) 84%, var(--color-ivory));
    font-size: var(--font-size-meta);
    font-weight: 700;
    letter-spacing: 0.025em;
    text-decoration: none;
  }

  .home-hero__schedule-link span {
    transition: translate var(--duration-short) var(--ease-editorial);
  }

  .home-hero__schedule-link:hover span {
    translate: 0.25rem;
  }

  .home-hero__schedule-note {
    margin: 0;
    color: color-mix(in srgb, var(--color-ivory) 64%, transparent);
    font-size: var(--font-size-micro);
    line-height: 1.5;
  }

  .home-hero__scroll {
    position: absolute;
    z-index: 5;
    bottom: 2rem;
    left: 50%;
    display: flex;
    width: 3rem;
    height: 3rem;
    translate: -50%;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-ivory) 60%, transparent);
    animation: home-scroll-nudge 3.2s var(--motion-ease-standard) infinite;
  }

  .home-hero__indicators {
    position: absolute;
    z-index: 5;
    bottom: 5rem;
    left: 50%;
    display: flex;
    translate: -50%;
    align-items: center;
  }

  .home-hero__indicators button {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ivory);
    cursor: pointer;
  }

  .home-hero__indicators span {
    width: 0.375rem;
    height: 0.375rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    transition:
      width var(--duration-short) var(--ease-editorial),
      background-color var(--duration-short) var(--ease-editorial);
  }

  .home-hero__indicators button[aria-pressed='true'] span {
    width: 1.5rem;
    border-radius: 0;
    background: currentColor;
  }

  @keyframes home-scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(0.2rem);
    }
  }

  @media (min-width: 48rem) {
    .home-hero__slide :global(img),
    .home-hero__reveal :global(img) {
    }

    .home-hero__schedule {
      display: block;
    }
  }

  @media (max-width: 47.999rem) {
    .home-hero__copy {
      max-width: 35rem;
    }
  }

  @media (max-width: 30rem) {
    .home-hero__actions :global(.ui-button) {
      width: 100%;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero__lens-outline {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__lens-definition,
    .home-hero__reveals,
    .home-hero__lens-outline,
    .home-hero__lens-metric {
      display: none;
      transition: none;
    }

    .home-hero__slide {
      display: none;
      transition: none;
    }

    .home-hero__slide:first-child {
      display: block;
      opacity: 1;
    }

    .home-hero__slide :global(img),
    .home-hero__slide[data-active='true'] :global(img) {
      animation: none;
      scale: 1;
    }

    .home-hero__indicators {
      display: none;
    }
  }
</style>
