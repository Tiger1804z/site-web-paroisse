---
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import RemoteImage from '@/components/ui/RemoteImage.astro';
import type { HomeGalleryContent } from '@/types/homePage';

interface Props {
  content: HomeGalleryContent;
}

const { content } = Astro.props;
const items = content.items;
// Plus de `getImage` : ces photographies sont téléversées dans le Studio et ne
// sont pas connues au build. `src` est déjà la plus grande variante servie par
// le CDN, c'est elle qu'ouvre la loupe.
const initialItem = items[0];
---

<section
  id="galerie-accueil"
  class="home-gallery"
  aria-labelledby="home-gallery-title"
  data-home-gallery-root
>
  <Container class="home-gallery__heading" data-motion-reveal>
    <Eyebrow>{content.eyebrow}</Eyebrow>
    <h2 id="home-gallery-title" class="type-h2">{content.title}</h2>
  </Container>

  <div
    class="home-gallery__carousel"
    data-home-gallery
    role="region"
    aria-roledescription="carrousel"
    aria-label="Photographies de la paroisse"
  >
    <button
      class="home-gallery__control home-gallery__control--previous"
      type="button"
      aria-label="Afficher la photographie précédente"
      data-home-gallery-previous
      hidden
    >
      <svg
        viewBox="0 0 32 32"
        width="32"
        height="32"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m20 6-10 10 10 10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="home-gallery__stage">
      {
        items.map((item, index) => (
          <a
            class="home-gallery__item"
            href={item.image.src}
            target="_blank"
            rel="noreferrer"
            aria-label={`Agrandir : ${item.title}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-home-gallery-item
            data-gallery-position={index === 0 ? '0' : undefined}
            data-gallery-title={item.title}
            data-gallery-description={item.description}
            data-gallery-alt={item.image.alt}
            data-gallery-credit={item.image.credit}
            data-gallery-full-width={item.image.width}
            data-gallery-full-height={item.image.height}
          >
            <RemoteImage
              image={item.image}
              sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 36vw, 78vw"
            />
            <span class="home-gallery__open-cue" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="m15.25 15.25 4 4M10.5 7.5v6M7.5 10.5h6" />
              </svg>
              Agrandir
            </span>
          </a>
        ))
      }
    </div>

    <button
      class="home-gallery__control home-gallery__control--next"
      type="button"
      aria-label="Afficher la photographie suivante"
      data-home-gallery-next
      hidden
    >
      <svg
        viewBox="0 0 32 32"
        width="32"
        height="32"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m12 6 10 10-10 10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  {
    initialItem && (
      <div
        class="home-gallery__caption"
        aria-live="polite"
        aria-atomic="true"
        data-home-gallery-caption
      >
        <p data-home-gallery-caption-title>{initialItem.title}</p>
        <span data-home-gallery-caption-description>
          {initialItem.description}
        </span>
        <small data-home-gallery-caption-counter>1 / {items.length}</small>
      </div>
    )
  }

  <dialog
    class="home-gallery-lightbox"
    aria-labelledby="home-gallery-lightbox-title"
    data-home-gallery-lightbox
  >
    <div class="home-gallery-lightbox__panel">
      <button
        class="home-gallery-lightbox__close"
        type="button"
        aria-label="Fermer la photographie agrandie"
        data-home-gallery-lightbox-close
      >
        <svg
          viewBox="0 0 24 24"
          width="26"
          height="26"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M5 5l14 14M19 5 5 19"></path>
        </svg>
      </button>

      <button
        class="home-gallery-lightbox__navigation home-gallery-lightbox__navigation--previous"
        type="button"
        aria-label="Photographie précédente"
        data-home-gallery-lightbox-previous
      >
        <svg
          viewBox="0 0 24 24"
          width="28"
          height="28"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m15 5-7 7 7 7"></path>
        </svg>
      </button>

      <figure>
        <div class="home-gallery-lightbox__media">
          <img
            src=""
            alt=""
            width="1600"
            height="1200"
            data-home-gallery-lightbox-image
          />
        </div>
        <figcaption>
          <p id="home-gallery-lightbox-title" data-home-gallery-lightbox-title>
          </p>
          <span data-home-gallery-lightbox-description></span>
          <small data-home-gallery-lightbox-credit></small>
          <em data-home-gallery-lightbox-counter></em>
        </figcaption>
      </figure>

      <button
        class="home-gallery-lightbox__navigation home-gallery-lightbox__navigation--next"
        type="button"
        aria-label="Photographie suivante"
        data-home-gallery-lightbox-next
      >
        <svg
          viewBox="0 0 24 24"
          width="28"
          height="28"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m9 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </dialog>
</section>

<script>
  const initializeHomeGalleries = () => {
    document
      .querySelectorAll<HTMLElement>('[data-home-gallery-root]')
      .forEach((root) => {
        if (root.dataset.initialized === 'true') return;

        const carousel = root.querySelector<HTMLElement>('[data-home-gallery]');
        const items = Array.from(
          root.querySelectorAll<HTMLAnchorElement>('[data-home-gallery-item]'),
        );
        const previous = root.querySelector<HTMLButtonElement>(
          '[data-home-gallery-previous]',
        );
        const next = root.querySelector<HTMLButtonElement>(
          '[data-home-gallery-next]',
        );
        const caption = root.querySelector<HTMLElement>(
          '[data-home-gallery-caption]',
        );
        const captionTitle = root.querySelector<HTMLElement>(
          '[data-home-gallery-caption-title]',
        );
        const captionDescription = root.querySelector<HTMLElement>(
          '[data-home-gallery-caption-description]',
        );
        const captionCounter = root.querySelector<HTMLElement>(
          '[data-home-gallery-caption-counter]',
        );
        const dialog = root.querySelector<HTMLDialogElement>(
          '[data-home-gallery-lightbox]',
        );
        const dialogImage = root.querySelector<HTMLImageElement>(
          '[data-home-gallery-lightbox-image]',
        );
        const dialogTitle = root.querySelector<HTMLElement>(
          '[data-home-gallery-lightbox-title]',
        );
        const dialogDescription = root.querySelector<HTMLElement>(
          '[data-home-gallery-lightbox-description]',
        );
        const dialogCredit = root.querySelector<HTMLElement>(
          '[data-home-gallery-lightbox-credit]',
        );
        const dialogCounter = root.querySelector<HTMLElement>(
          '[data-home-gallery-lightbox-counter]',
        );
        const dialogClose = root.querySelector<HTMLButtonElement>(
          '[data-home-gallery-lightbox-close]',
        );
        const dialogPrevious = root.querySelector<HTMLButtonElement>(
          '[data-home-gallery-lightbox-previous]',
        );
        const dialogNext = root.querySelector<HTMLButtonElement>(
          '[data-home-gallery-lightbox-next]',
        );

        if (
          !carousel ||
          !previous ||
          !next ||
          !caption ||
          !captionTitle ||
          !captionDescription ||
          !captionCounter ||
          items.length === 0
        ) {
          return;
        }

        root.dataset.initialized = 'true';
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        );
        let activeIndex = 0;
        let pointerStartX: number | undefined;
        let captionTimer: number | undefined;
        let returnFocus: HTMLAnchorElement | null = null;

        const writeCaption = () => {
          const item = items[activeIndex];
          captionTitle.textContent = item.dataset.galleryTitle ?? '';
          captionDescription.textContent =
            item.dataset.galleryDescription ?? '';
          captionCounter.textContent = `${activeIndex + 1} / ${items.length}`;
        };

        const renderCaption = (animate: boolean) => {
          if (captionTimer !== undefined) {
            window.clearTimeout(captionTimer);
          }
          if (!animate || reducedMotion.matches) {
            caption.dataset.state = 'visible';
            writeCaption();
            return;
          }

          caption.dataset.state = 'changing';
          captionTimer = window.setTimeout(() => {
            writeCaption();
            caption.dataset.state = 'visible';
            captionTimer = undefined;
          }, 150);
        };

        const update = (animateCaption = false) => {
          const half = Math.floor(items.length / 2);
          items.forEach((item, index) => {
            let position =
              ((index - activeIndex + items.length + half) % items.length) -
              half;
            if (items.length % 2 === 0 && position === -half) {
              position = -3;
            }
            item.dataset.galleryPosition =
              position >= -2 && position <= 2 ? String(position) : 'hidden';
            const isCurrent = position === 0;
            if (isCurrent) item.setAttribute('aria-current', 'true');
            else item.removeAttribute('aria-current');
            item.setAttribute('aria-hidden', String(!isCurrent));
            item.tabIndex = isCurrent ? 0 : -1;
          });
          renderCaption(animateCaption);
        };

        const setActive = (index: number, animateCaption = true) => {
          activeIndex = (index + items.length) % items.length;
          update(animateCaption);
        };

        const move = (direction: -1 | 1) => {
          setActive(activeIndex + direction);
        };

        const renderDialog = () => {
          const item = items[activeIndex];
          if (
            !dialogImage ||
            !dialogTitle ||
            !dialogDescription ||
            !dialogCredit ||
            !dialogCounter
          ) {
            return;
          }
          dialogImage.src = item.href;
          dialogImage.alt = item.dataset.galleryAlt ?? '';
          dialogImage.width = Number(item.dataset.galleryFullWidth) || 1600;
          dialogImage.height = Number(item.dataset.galleryFullHeight) || 1200;
          dialogTitle.textContent = item.dataset.galleryTitle ?? '';
          dialogDescription.textContent = item.dataset.galleryDescription ?? '';
          dialogCredit.textContent = item.dataset.galleryCredit ?? '';
          dialogCredit.hidden = dialogCredit.textContent.length === 0;
          dialogCounter.textContent = `${activeIndex + 1} / ${items.length}`;
        };

        const openDialog = (item: HTMLAnchorElement) => {
          if (
            !dialog ||
            !dialogClose ||
            typeof dialog.showModal !== 'function'
          ) {
            return;
          }
          const index = items.indexOf(item);
          if (index < 0) return;
          setActive(index, false);
          returnFocus = item;
          renderDialog();
          dialog.showModal();
          document.documentElement.dataset.homeGalleryModalOpen = 'true';
          dialogClose.focus();
        };

        previous.hidden = items.length < 2;
        next.hidden = items.length < 2;
        previous.addEventListener('click', () => move(-1));
        next.addEventListener('click', () => move(1));
        carousel.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            move(-1);
          }
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            move(1);
          }
        });
        carousel.addEventListener(
          'pointerdown',
          (event) => {
            if (event.pointerType === 'mouse') return;
            pointerStartX = event.clientX;
          },
          { passive: true },
        );
        carousel.addEventListener(
          'pointerup',
          (event) => {
            if (pointerStartX === undefined || event.pointerType === 'mouse') {
              return;
            }
            const distance = event.clientX - pointerStartX;
            pointerStartX = undefined;
            if (Math.abs(distance) < 42) return;
            move(distance > 0 ? -1 : 1);
          },
          { passive: true },
        );

        items.forEach((item) => {
          item.addEventListener('click', (event) => {
            if (
              dialog &&
              dialogClose &&
              typeof dialog.showModal === 'function'
            ) {
              event.preventDefault();
              openDialog(item);
            }
          });
        });

        if (
          dialog &&
          dialogClose &&
          dialogPrevious &&
          dialogNext &&
          dialogImage
        ) {
          const moveDialog = (direction: -1 | 1) => {
            setActive(activeIndex + direction);
            renderDialog();
          };
          dialogClose.addEventListener('click', () => dialog.close());
          dialogPrevious.addEventListener('click', () => moveDialog(-1));
          dialogNext.addEventListener('click', () => moveDialog(1));
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          dialog.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              moveDialog(-1);
            }
            if (event.key === 'ArrowRight') {
              event.preventDefault();
              moveDialog(1);
            }
          });
          dialog.addEventListener('close', () => {
            delete document.documentElement.dataset.homeGalleryModalOpen;
            dialogImage.removeAttribute('src');
            returnFocus?.focus();
          });
        }

        carousel.dataset.ready = 'true';
        caption.dataset.state = 'visible';
        update();
      });
  };

  initializeHomeGalleries();
  document.addEventListener('astro:page-load', initializeHomeGalleries);
</script>

<style>
  :global(html[data-home-gallery-modal-open='true']) {
    overflow: hidden;
  }

  .home-gallery {
    overflow: hidden;
    padding-block: clamp(4.75rem, 7vw, 7rem);
    background:
      radial-gradient(
        circle at 50% 48%,
        color-mix(in srgb, var(--color-gold) 5%, transparent),
        transparent 36rem
      ),
      var(--color-paper);
  }

  .home-gallery__heading {
    display: grid;
    justify-items: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
  }

  .home-gallery__heading h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
    font-size: clamp(2.25rem, 1.971rem + 1.143vw, 3rem);
  }

  .home-gallery__heading :global(.ui-eyebrow) {
    color: var(--color-wood);
  }

  .home-gallery__carousel {
    position: relative;
    min-height: clamp(21rem, 34vw, 31rem);
    overflow: hidden;
    touch-action: pan-y;
  }

  .home-gallery__stage {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0 var(--gutter-page) 1rem;
    scrollbar-width: none;
  }

  .home-gallery__stage::after {
    width: max(0.5rem, calc((100vw - var(--layout-max)) / 2));
    flex: 0 0 auto;
    content: '';
  }

  .home-gallery__stage::-webkit-scrollbar {
    display: none;
  }

  .home-gallery__item {
    position: relative;
    width: 16rem;
    flex: 0 0 auto;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid color-mix(in srgb, var(--color-burgundy) 22%, transparent);
    background: var(--color-surface);
    color: inherit;
    box-shadow: 0 0.75rem 2rem rgb(33 24 24 / 8%);
    text-decoration: none;
  }

  .home-gallery__item::after {
    position: absolute;
    inset: 0.45rem;
    border: 1px solid rgb(255 255 255 / 45%);
    content: '';
    pointer-events: none;
  }

  .home-gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-editorial);
  }

  .home-gallery__item:hover :global(img),
  .home-gallery__item:focus-visible :global(img) {
    scale: 1.025;
  }

  .home-gallery__open-cue {
    position: absolute;
    z-index: 2;
    right: 1.15rem;
    bottom: 1.15rem;
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: rgb(34 22 24 / 72%);
    color: var(--color-ivory);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0;
    text-transform: uppercase;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: opacity var(--duration-short) var(--ease-editorial);
  }

  .home-gallery__item:hover .home-gallery__open-cue,
  .home-gallery__item:focus-visible .home-gallery__open-cue {
    opacity: 1;
  }

  .home-gallery__control {
    position: absolute;
    z-index: 8;
    top: 50%;
    display: grid;
    width: clamp(3.25rem, 4vw, 4rem);
    height: clamp(3.25rem, 4vw, 4rem);
    translate: 0 -50%;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 24%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    color: var(--color-burgundy-dark);
    box-shadow: 0 0.75rem 2rem rgb(28 25 24 / 9%);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      translate var(--duration-short) var(--ease-editorial),
      border-color var(--duration-short) var(--ease-editorial),
      background-color var(--duration-short) var(--ease-editorial),
      color var(--duration-short) var(--ease-editorial);
  }

  .home-gallery__control:hover {
    border-color: var(--color-burgundy);
    background: var(--color-burgundy);
    color: var(--color-ivory);
  }

  .home-gallery__control--previous {
    left: max(1rem, calc((100vw - var(--layout-max)) / 2));
  }

  .home-gallery__control--previous:hover {
    translate: -0.2rem -50%;
  }

  .home-gallery__control--next {
    right: max(1rem, calc((100vw - var(--layout-max)) / 2));
  }

  .home-gallery__control--next:hover {
    translate: 0.2rem -50%;
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__stage {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
    padding: 0;
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__stage::after {
    display: none;
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(19rem, 29vw, 29rem);
    opacity: 0;
    filter: saturate(0.72) brightness(0.82);
    transform: translate(-50%, -50%) scale(0.55);
    pointer-events: none;
    will-change: transform, opacity, filter;
    transition:
      transform 760ms var(--motion-ease-emphasized),
      opacity 600ms var(--motion-ease-standard),
      filter 650ms var(--motion-ease-standard),
      box-shadow 650ms var(--motion-ease-standard);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='0'] {
    z-index: 5;
    opacity: 1;
    filter: none;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-gold) 72%, transparent),
      0 1.75rem 4.5rem rgb(45 27 29 / 22%);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='-1'] {
    z-index: 4;
    opacity: 0.92;
    transform: translate(calc(-50% - clamp(14rem, 22vw, 21rem)), -50%)
      scale(0.79);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='1'] {
    z-index: 4;
    opacity: 0.92;
    transform: translate(calc(-50% + clamp(14rem, 22vw, 21rem)), -50%)
      scale(0.79);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='-2'] {
    z-index: 3;
    opacity: 0.64;
    transform: translate(calc(-50% - clamp(26rem, 40vw, 38rem)), -50%)
      scale(0.6);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='2'] {
    z-index: 3;
    opacity: 0.64;
    transform: translate(calc(-50% + clamp(26rem, 40vw, 38rem)), -50%)
      scale(0.6);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='hidden'] {
    visibility: hidden;
  }

  .home-gallery__caption {
    position: relative;
    display: grid;
    width: min(42rem, calc(100% - 2 * var(--gutter-page)));
    min-height: 7rem;
    justify-items: center;
    gap: 0.35rem;
    margin: clamp(1rem, 2vw, 1.75rem) auto 0;
    padding-top: 1.5rem;
    text-align: center;
    transition:
      opacity 260ms var(--ease-editorial),
      translate 260ms var(--ease-editorial);
  }

  .home-gallery__caption::before {
    width: clamp(4rem, 8vw, 6.5rem);
    height: 1px;
    margin-bottom: 0.45rem;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-gold),
      transparent
    );
    content: '';
  }

  .home-gallery__caption[data-state='changing'] {
    opacity: 0;
    translate: 0 0.4rem;
  }

  .home-gallery__caption p {
    margin: 0;
    color: var(--color-charcoal);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .home-gallery__caption span {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: var(--font-size-ui);
    line-height: 1.6;
  }

  .home-gallery__caption small {
    margin-top: 0.35rem;
    color: var(--color-wood);
    font-size: var(--font-size-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .home-gallery-lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 15 17 / 97%);
    color: var(--color-ivory);
  }

  .home-gallery-lightbox::backdrop {
    background: rgb(20 15 17 / 97%);
  }

  .home-gallery-lightbox__panel {
    position: relative;
    display: grid;
    min-height: 100%;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
    padding: clamp(4.5rem, 8vw, 6rem) clamp(1rem, 4vw, 4rem) 2rem;
  }

  .home-gallery-lightbox figure {
    display: grid;
    min-width: 0;
    max-width: min(76rem, 78vw);
    max-height: calc(100svh - 7rem);
    justify-self: center;
    margin: 0;
  }

  .home-gallery-lightbox__media {
    display: grid;
    min-height: 0;
    place-items: center;
  }

  .home-gallery-lightbox__media img {
    display: block;
    max-width: 100%;
    max-height: min(72svh, 52rem);
