---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import redAltarImage from '@/assets/images/paroisse/autel-decor-rouge-01.jpg';
import floralImage from '@/assets/images/paroisse/autel-fleurs-blanches-01.jpg';
import crossImage from '@/assets/images/paroisse/croix-verre-entree-01.webp';
import bellTowersImage from '@/assets/images/paroisse/eglise-exterieur-clochers-01.webp';
import identificationImage from '@/assets/images/paroisse/eglise-exterieur-identification-01.webp';
import interiorImage from '@/assets/images/paroisse/interieur-eglise-decoration-01.webp';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import TextLink from '@/components/ui/TextLink.astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  aspect: 'landscape' | 'portrait';
  objectPosition?: string;
}

const gallery: readonly GalleryItem[] = [
  {
    image: redAltarImage,
    alt: 'Vue intérieure de l’autel avec une décoration rouge',
    aspect: 'landscape',
  },
  {
    image: bellTowersImage,
    alt: 'Vue extérieure de l’église et des structures portant des cloches',
    aspect: 'portrait',
    objectPosition: '38% center',
  },
  {
    image: crossImage,
    alt: 'Croix composée de verre coloré intégrée à une paroi de béton',
    aspect: 'portrait',
  },
  {
    image: floralImage,
    alt: 'Vue intérieure de l’autel entouré de fleurs blanches',
    aspect: 'landscape',
  },
  {
    image: interiorImage,
    alt: 'Vue verticale de l’autel avec une décoration liturgique',
    aspect: 'portrait',
  },
  {
    image: identificationImage,
    alt: 'Vue extérieure du bâtiment et de l’identification de la paroisse',
    aspect: 'landscape',
  },
];
---

<section
  id="galerie-accueil"
  class="home-gallery"
  aria-labelledby="home-gallery-title"
>
  <Container class="home-gallery__heading" data-motion-reveal>
    <div>
      <Eyebrow>Photographie</Eyebrow>
      <h2 id="home-gallery-title" class="type-h2">La paroisse en images</h2>
    </div>
    <TextLink href="/galerie">Voir toute la galerie</TextLink>
  </Container>

  <div
    class="home-gallery__carousel"
    data-home-gallery
    role="region"
    aria-roledescription="carrousel"
    aria-label="Photographies de la paroisse"
  >
    <button
      class="home-gallery__control home-gallery__control--previous"
      type="button"
      aria-label="Afficher la photographie précédente"
      data-home-gallery-previous
      hidden
    >
      <svg
        viewBox="0 0 32 32"
        width="32"
        height="32"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m20 6-10 10 10 10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="home-gallery__stage" aria-live="polite">
      {
        gallery.map((item, index) => (
          <a
            class:list={[
              'home-gallery__item',
              `home-gallery__item--${item.aspect}`,
            ]}
            href="/galerie"
            aria-label={`Voir la galerie : ${item.alt}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-home-gallery-item
            data-gallery-position={index === 0 ? '0' : undefined}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[320, 480, 640, 800]}
              sizes="(min-width: 64rem) 26rem, 78vw"
              loading="lazy"
              quality={76}
              style={
                item.objectPosition
                  ? `object-position: ${item.objectPosition}`
                  : undefined
              }
            />
          </a>
        ))
      }
    </div>

    <button
      class="home-gallery__control home-gallery__control--next"
      type="button"
      aria-label="Afficher la photographie suivante"
      data-home-gallery-next
      hidden
    >
      <svg
        viewBox="0 0 32 32"
        width="32"
        height="32"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m12 6 10 10-10 10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-home-gallery]')
    .forEach((carousel) => {
      if (carousel.dataset.initialized === 'true') return;
      carousel.dataset.initialized = 'true';

      const items = Array.from(
        carousel.querySelectorAll<HTMLAnchorElement>(
          '[data-home-gallery-item]',
        ),
      );
      const previous = carousel.querySelector<HTMLButtonElement>(
        '[data-home-gallery-previous]',
      );
      const next = carousel.querySelector<HTMLButtonElement>(
        '[data-home-gallery-next]',
      );
      if (!previous || !next || items.length === 0) return;

      let activeIndex = 0;
      let pointerStartX: number | undefined;

      const update = () => {
        const half = Math.floor(items.length / 2);
        items.forEach((item, index) => {
          let position =
            ((index - activeIndex + items.length + half) % items.length) - half;
          if (items.length % 2 === 0 && position === -half) {
            position = -3;
          }
          item.dataset.galleryPosition =
            position >= -2 && position <= 2 ? String(position) : 'hidden';
          const isCurrent = position === 0;
          item.toggleAttribute('aria-current', isCurrent);
          item.setAttribute('aria-hidden', String(!isCurrent));
          item.tabIndex = isCurrent ? 0 : -1;
        });
      };

      const move = (direction: -1 | 1) => {
        activeIndex = (activeIndex + direction + items.length) % items.length;
        update();
      };

      previous.hidden = false;
      next.hidden = false;
      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          move(-1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          move(1);
        }
      });
      carousel.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType === 'mouse') return;
          pointerStartX = event.clientX;
        },
        { passive: true },
      );
      carousel.addEventListener(
        'pointerup',
        (event) => {
          if (pointerStartX === undefined || event.pointerType === 'mouse') {
            return;
          }
          const distance = event.clientX - pointerStartX;
          pointerStartX = undefined;
          if (Math.abs(distance) < 42) return;
          move(distance > 0 ? -1 : 1);
        },
        { passive: true },
      );

      carousel.dataset.ready = 'true';
      update();
    });
</script>

<style>
  .home-gallery {
    overflow: hidden;
    padding-block: 5rem;
    background: var(--color-paper);
  }

  .home-gallery__heading {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .home-gallery__heading h2 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
    font-size: clamp(2.25rem, 1.971rem + 1.143vw, 3rem);
  }

  .home-gallery__heading :global(.ui-eyebrow) {
    color: var(--color-wood);
  }

  .home-gallery__heading :global(.ui-text-link) {
    align-self: flex-start;
  }

  .home-gallery__carousel {
    position: relative;
    min-height: clamp(21rem, 34vw, 31rem);
    overflow: hidden;
    touch-action: pan-y;
  }

  .home-gallery__carousel:focus-visible {
    outline: 2px solid var(--color-burgundy);
    outline-offset: -0.25rem;
  }

  .home-gallery__stage {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0 var(--gutter-page) 1rem;
    scrollbar-width: none;
  }

  .home-gallery__stage::after {
    width: max(0.5rem, calc((100vw - var(--layout-max)) / 2));
    flex: 0 0 auto;
    content: '';
  }

  .home-gallery__stage::-webkit-scrollbar {
    display: none;
  }

  .home-gallery__item {
    width: 16rem;
    flex: 0 0 auto;
    overflow: hidden;
    background: var(--color-surface);
  }

  .home-gallery__item--landscape {
    aspect-ratio: 4 / 3;
  }

  .home-gallery__item--portrait {
    aspect-ratio: 3 / 4;
  }

  .home-gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--duration-media) var(--ease-editorial);
  }

  .home-gallery__item:hover :global(img) {
    scale: var(--motion-scale-hover);
  }

  .home-gallery__control {
    position: absolute;
    z-index: 8;
    top: 50%;
    display: grid;
    width: clamp(3rem, 4vw, 4rem);
    height: clamp(3rem, 4vw, 4rem);
    translate: 0 -50%;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 28%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-paper) 84%, transparent);
    color: var(--color-burgundy-dark);
    box-shadow: 0 0.75rem 2rem rgb(28 25 24 / 9%);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition:
      border-color var(--duration-short) var(--ease-editorial),
      background-color var(--duration-short) var(--ease-editorial),
      color var(--duration-short) var(--ease-editorial);
  }

  .home-gallery__control:hover {
    border-color: var(--color-burgundy);
    background: var(--color-burgundy);
    color: var(--color-ivory);
  }

  .home-gallery__control--previous {
    left: max(0.75rem, calc((100vw - var(--layout-max)) / 2));
  }

  .home-gallery__control--next {
    right: max(0.75rem, calc((100vw - var(--layout-max)) / 2));
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__stage {
    position: absolute;
    inset: 0;
    display: block;
    overflow: visible;
    padding: 0;
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__stage::after {
    display: none;
  }

  .home-gallery__carousel[data-ready='true'] .home-gallery__item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(18rem, 27vw, 26rem);
    aspect-ratio: 4 / 3;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.55);
    pointer-events: none;
    transition:
      transform 520ms var(--motion-ease-emphasized),
      opacity 420ms var(--motion-ease-standard),
      filter 420ms var(--motion-ease-standard);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='0'] {
    z-index: 5;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='-1'] {
    z-index: 4;
    opacity: 0.94;
    transform: translate(calc(-50% - clamp(13rem, 21vw, 19rem)), -50%)
      scale(0.8);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='1'] {
    z-index: 4;
    opacity: 0.94;
    transform: translate(calc(-50% + clamp(13rem, 21vw, 19rem)), -50%)
      scale(0.8);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='-2'] {
    z-index: 3;
    opacity: 0.78;
    transform: translate(calc(-50% - clamp(24rem, 38vw, 34rem)), -50%)
      scale(0.61);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='2'] {
    z-index: 3;
    opacity: 0.78;
    transform: translate(calc(-50% + clamp(24rem, 38vw, 34rem)), -50%)
      scale(0.61);
  }

  .home-gallery__carousel[data-ready='true']
    .home-gallery__item[data-gallery-position='hidden'] {
    visibility: hidden;
  }

  @media (min-width: 48rem) {
    .home-gallery__heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .home-gallery__carousel[data-ready='true'] .home-gallery__item {
      width: clamp(20rem, 27vw, 26rem);
    }
  }

  @media (max-width: 47.99rem) {
    .home-gallery {
      padding-block: 4rem;
    }

    .home-gallery__carousel {
      min-height: 23rem;
    }

    .home-gallery__carousel[data-ready='true'] .home-gallery__item {
      width: min(78vw, 20rem);
    }

    .home-gallery__carousel[data-ready='true']
      .home-gallery__item[data-gallery-position='-1'] {
      transform: translate(calc(-50% - 62vw), -50%) scale(0.72);
    }

    .home-gallery__carousel[data-ready='true']
      .home-gallery__item[data-gallery-position='1'] {
      transform: translate(calc(-50% + 62vw), -50%) scale(0.72);
    }

    .home-gallery__carousel[data-ready='true']
      .home-gallery__item[data-gallery-position='-2'],
    .home-gallery__carousel[data-ready='true']
      .home-gallery__item[data-gallery-position='2'] {
      visibility: hidden;
    }

    .home-gallery__control {
      top: auto;
      bottom: 0.5rem;
      translate: 0;
    }

    .home-gallery__control--previous {
      left: calc(50% - 4rem);
    }

    .home-gallery__control--next {
      right: calc(50% - 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-gallery__carousel[data-ready='true'] .home-gallery__item,
    .home-gallery__item :global(img),
    .home-gallery__control {
      transition: none;
    }
  }
</style>
