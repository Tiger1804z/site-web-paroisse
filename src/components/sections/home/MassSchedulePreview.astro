---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import {
  formatTimeLabel,
  WEEKDAY_LABELS,
} from '@/lib/schedules/schedule-format.ts';
import type { HomeMassPreviewContent } from '@/types/homePage';
import type { WeeklyMassEntry } from '@/types/schedule';

interface Props {
  content: HomeMassPreviewContent;
  masses?: readonly WeeklyMassEntry[];
  lastUpdatedLabel?: string;
}

const { content, masses = [], lastUpdatedLabel } = Astro.props;

const schedule = masses.map((mass) => ({
  id: mass.id,
  day: WEEKDAY_LABELS[mass.weekday],
  note: mass.note ?? mass.title,
  time: formatTimeLabel(mass.time) ?? mass.time,
}));

// Texte d'attente : il ne s'affiche que si aucune heure n'est publiée, et dit
// alors le contraire de l'introduction saisie dans le Studio — annoncer des
// horaires « ci-dessous » sous une liste vide serait faux. Un état dégradé
// appartient au code, pas au CMS.
const EMPTY_SCHEDULE_INTRODUCTION =
  'Les horaires réguliers seront publiés après leur confirmation. Ils peuvent être modifiés lors des fêtes et des célébrations spéciales.';

const introduction =
  schedule.length > 0 ? content.introduction : EMPTY_SCHEDULE_INTRODUCTION;
---

<section
  class="mass-schedule section-block"
  aria-labelledby="mass-schedule-title"
>
  <div class="mass-schedule__beam" aria-hidden="true"></div>
  <Container>
    <div class="mass-schedule__grid">
      <div class="mass-schedule__copy">
        <Eyebrow tone="light">{content.eyebrow}</Eyebrow>
        <h2 id="mass-schedule-title" class="type-h2">{content.title}</h2>
        <p class="type-body">{introduction}</p>
        <div class="mass-schedule__actions">
          <Button href="/horaires">{content.ctaLabel}</Button>
        </div>
      </div>

      <div class="mass-schedule__list">
        {
          schedule.length > 0 ? (
            schedule.map((item) => (
              <div class="mass-schedule__row">
                <div>
                  <h3>{item.day}</h3>
                  <p>{item.note}</p>
                </div>
                <span>{item.time}</span>
              </div>
            ))
          ) : (
            <div class="mass-schedule__row">
              <div>
                <h3>Horaires à confirmer</h3>
                <p>
                  Les heures seront publiées dès leur confirmation avec la
                  paroisse.
                </p>
              </div>
            </div>
          )
        }
        <div class="mass-schedule__special">
          <div>
            <h3>{content.specialTitle}</h3>
            <p>{content.specialDescription}</p>
          </div>
        </div>
        {
          lastUpdatedLabel && (
            <p class="mass-schedule__updated">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Dernière mise à jour&nbsp;: {lastUpdatedLabel}
            </p>
          )
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .mass-schedule {
    position: relative;
    overflow: hidden;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .mass-schedule__beam {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-gold) 10%, transparent),
      color-mix(in srgb, var(--color-gold) 5%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .mass-schedule__grid {
    position: relative;
    display: grid;
    gap: 4rem;
  }

  .mass-schedule__copy {
    max-width: 37.5rem;
  }

  .mass-schedule h2 {
    margin: 1rem 0 0;
    color: var(--color-ivory);
  }

  .mass-schedule__copy > .type-body {
    max-width: 30rem;
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 68%, transparent);
  }

  .mass-schedule__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .mass-schedule__list {
    display: grid;
  }

  .mass-schedule__row,
  .mass-schedule__special {
    display: flex;
    min-height: 5.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: -1rem;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ivory) 10%, transparent);
    transition: background-color var(--duration-short) var(--ease-editorial);
  }

  .mass-schedule__row:hover,
  .mass-schedule__special:hover {
    background: color-mix(in srgb, var(--color-ivory) 5%, transparent);
  }

  .mass-schedule__row h3,
  .mass-schedule__special h3 {
    margin: 0;
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .mass-schedule__row p,
  .mass-schedule__special p {
    margin: 0.25rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 55%, transparent);
    font-size: var(--font-size-meta);
    line-height: 1.45;
  }

  .mass-schedule__row > span {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .mass-schedule__updated {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 50%, transparent);
    font-size: var(--font-size-meta);
  }

  .mass-schedule__updated svg {
    flex: 0 0 auto;
  }

  @media (min-width: 64rem) {
    .mass-schedule__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  @media (max-width: 30rem) {
    .mass-schedule__actions :global(.ui-button) {
      width: 100%;
    }
  }
</style>
