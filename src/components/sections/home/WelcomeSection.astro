---
import LivingStainedGlass from '@/components/motion/LivingStainedGlass.astro';
import Reveal from '@/components/motion/Reveal.astro';
import Container from '@/components/ui/Container.astro';
import TextLink from '@/components/ui/TextLink.astro';
---

<section
  class="welcome-section section-block"
  aria-labelledby="bienvenue-title"
>
  <Container>
    <div class="welcome-section__grid">
      <Reveal class="welcome-section__copy">
        <p class="type-script-accent welcome-section__script">Ensemble</p>
        <h2 id="bienvenue-title" class="type-h2" tabindex="-1">
          Une communauté<br />enracinée dans la foi
        </h2>
        <p class="type-body welcome-section__introduction">
          Notre paroisse est un lieu de prière, de rencontre et de solidarité,
          ouvert à toutes les personnes qui souhaitent cheminer dans la foi. Que
          vous soyez de passage ou enraciné dans le quartier, vous êtes les
          bienvenus parmi nous.
        </p>
        <blockquote>
          <p>
            « Là où deux ou trois sont rassemblés en mon nom, je suis au milieu
            d’eux. »
          </p>
          <cite>Matthieu 18,20</cite>
        </blockquote>
        <TextLink href="/notre-paroisse">
          En savoir plus sur notre paroisse
        </TextLink>
      </Reveal>

      <div class="welcome-section__art">
        <LivingStainedGlass
          intensity={0.9}
          speed={0.8}
          parallax={4}
          grain={true}
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .welcome-section {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 84% 50%,
        color-mix(in srgb, var(--color-burgundy) 6%, transparent),
        transparent 31rem
      ),
      var(--color-ivory);
    padding-block: clamp(5.5rem, 8vw, 7.5rem);
  }

  .welcome-section__grid {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  .welcome-section__copy {
    max-width: 40.5rem;
  }

  .welcome-section__script {
    margin: 0 0 1rem;
    color: var(--color-wood);
  }

  .welcome-section h2 {
    margin: 0;
    color: var(--color-charcoal);
  }

  .welcome-section__introduction {
    max-width: 38rem;
    margin: 2rem 0 2.25rem;
    color: var(--color-muted);
  }

  .welcome-section blockquote {
    max-width: 34rem;
    margin: 0 0 2.5rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-gold);
  }

  .welcome-section blockquote p {
    margin: 0;
    color: color-mix(in srgb, var(--color-charcoal) 84%, transparent);
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-style: italic;
    line-height: 1.55;
  }

  .welcome-section cite {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-wood);
    font-size: var(--font-size-micro);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .welcome-section__art {
    position: relative;
    isolation: isolate;
    width: min(100%, 28.5rem);
    margin-inline: auto;
  }

  .welcome-section__art::before {
    position: absolute;
    z-index: -1;
    inset: 12% -12% 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-rose) 20%, transparent),
      transparent 68%
    );
    content: '';
    filter: blur(1.5rem);
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .welcome-section__grid {
      grid-template-columns: minmax(0, 1fr) minmax(23rem, 28.5rem);
      gap: clamp(3.5rem, 5vw, 5.5rem);
    }

    .welcome-section__art {
      width: 100%;
    }
  }
</style>
