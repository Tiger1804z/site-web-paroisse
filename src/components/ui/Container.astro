---
import type { HTMLAttributes } from 'astro/types';

type ContainerSize = 'full' | 'narrow' | 'reading';

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  size?: ContainerSize;
  class?: string;
};

const { size = 'full', class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={['ui-container', `ui-container--${size}`, className]}
>
  <slot />
</div>
