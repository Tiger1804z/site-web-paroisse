---
import type { ParishEventImage } from '@/types/parish-events';

interface Props {
  image: ParishEventImage;
  sizes: string;
  /**
   * Chaîne vide pour une image purement décorative, quand le texte voisin
   * porte déjà l'information. Par défaut, le texte alternatif saisi dans
   * le Studio.
   */
  alt?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  image,
  sizes,
  alt = image.alt,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
} = Astro.props;
---

{
  /*
  Image servie par le CDN de Sanity, déjà recadrée selon le point focal choisi
  dans le Studio. Les images locales du site continuent de passer par
  `astro:assets` : elles sont connues au build, celle-ci ne l'est pas.

  `width` et `height` réservent la place avant le chargement, et la vignette
  floue occupe l'espace en attendant — sans quoi la page saute au moment où
  l'image arrive.
*/
}
<img
  class={className}
  src={image.src}
  srcset={image.srcSet}
  sizes={sizes}
  alt={alt}
  width={image.width}
  height={image.height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  style={image.lqip
    ? `background-image: url(${image.lqip}); background-size: cover; background-position: center;`
    : undefined}
/>

<style>
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
