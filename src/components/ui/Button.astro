---
import type { HTMLAttributes } from 'astro/types';

type ButtonVariant =
  'primary' | 'secondary' | 'light' | 'dark' | 'text' | 'icon';

type ButtonType = 'button' | 'submit' | 'reset';
type ButtonAttributes = Omit<
  HTMLAttributes<'button'>,
  'class' | 'disabled' | 'type'
>;

type Props = ButtonAttributes & {
  variant?: ButtonVariant;
  href?: string;
  type?: ButtonType;
  disabled?: boolean;
  class?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  rel?: string;
  download?: boolean | string;
};

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  class: className,
  target,
  rel,
  download,
  ...attributes
} = Astro.props;

const isLink = typeof href === 'string';
const safeRel =
  target === '_blank'
    ? [rel, 'noopener', 'noreferrer'].filter(Boolean).join(' ')
    : rel;
const classes = [
  'ui-button',
  `ui-button--${variant}`,
  disabled && 'is-disabled',
  className,
];
---

{
  isLink && !disabled ? (
    <a
      {...attributes}
      class:list={classes}
      href={href}
      target={target}
      rel={safeRel}
      download={download}
    >
      <slot />
    </a>
  ) : isLink ? (
    <span
      {...attributes}
      class:list={classes}
      role="link"
      aria-disabled="true"
      data-disabled-link
    >
      <slot />
    </span>
  ) : (
    <button
      {...attributes}
      class:list={classes}
      type={type}
      disabled={disabled}
    >
      <slot />
    </button>
  )
}
