---
import {
  firstVisitNavigation,
  informationNavigation,
  primaryNavigation,
} from '@/lib/navigation';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import { SITE_NAME } from '@/lib/site';
import { getSiteSettings } from '@/lib/content/getSiteSettings';

interface Props {
  variant?: 'light' | 'transparent';
}

const { variant = 'light' } = Astro.props;
const currentPath =
  Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const informationIsActive = informationNavigation.some(
  (item) => item.href === currentPath,
);

/**
 * Mêmes coordonnées que le pied de page et que la page Contact.
 *
 * Elles étaient écrites `[ADRESSE]` et `[TÉLÉPHONE]` ici, sur les dix-huit
 * pages du site, pendant que le pied de page affichait les vraies valeurs deux
 * blocs plus bas. Le composant est asynchrone pour la même raison que `Footer` :
 * une coordonnée est un fait sur la paroisse, lu là où elle vit.
 */
const siteSettings = await getSiteSettings();
---

<header
  class="site-header"
  data-site-header
  data-variant={variant}
  data-scrolled={variant === 'light' ? 'true' : 'false'}
  data-menu-open="false"
>
  <div class="site-container site-header__container">
    <div class="site-header__inner">
      <a class="site-identity" href="/" aria-label={`Accueil — ${SITE_NAME}`}>
        <BrandLogo variant="mark" alt="" priority />
      </a>

      <nav class="site-header__desktop-nav" aria-label="Navigation principale">
        <ul class="site-header__desktop-list">
          {
            primaryNavigation.map((item) => (
              <li>
                <a
                  class="site-header__nav-link"
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <details
              class="information-menu"
              data-information-menu
              data-active={informationIsActive ? 'true' : 'false'}
            >
              <summary
                class="site-header__nav-link information-menu__summary"
                aria-label="Afficher les pages d’informations"
              >
                <span>Informations</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  width="12"
                  height="12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="m19 9-7 7-7-7"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </summary>
              <ul class="information-menu__panel">
                {
                  informationNavigation.map((item) => (
                    <li>
                      <a
                        class="information-menu__link"
                        href={item.href}
                        aria-current={
                          item.href === currentPath ? 'page' : undefined
                        }
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>
        </ul>
      </nav>

      <div class="site-header__desktop-actions">
        <a
          class="site-header__first-visit"
          href={firstVisitNavigation.href}
          aria-current={firstVisitNavigation.href === currentPath
            ? 'page'
            : undefined}
        >
          {firstVisitNavigation.label}
        </a>
      </div>

      <div class="site-header__mobile-actions">
        <button
          class="site-header__menu-button"
          type="button"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="site-mobile-menu"
          data-mobile-menu-toggle
        >
          <span class="site-header__menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="site-mobile-menu"
    class="mobile-menu"
    data-mobile-menu
    data-open="false"
    aria-hidden="true"
    inert
  >
    <div class="mobile-menu__scroll">
      <nav aria-label="Navigation mobile">
        <ul class="mobile-menu__list">
          {
            [...primaryNavigation, ...informationNavigation].map((item) => (
              <li>
                <a
                  class="mobile-menu__link"
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                  data-mobile-menu-link
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="mobile-menu__link"
              href={firstVisitNavigation.href}
              aria-current={firstVisitNavigation.href === currentPath
                ? 'page'
                : undefined}
              data-mobile-menu-link
            >
              {firstVisitNavigation.label}
            </a>
          </li>
        </ul>
      </nav>

      <div class="mobile-menu__details" role="group" aria-label="Coordonnées">
        <a
          class="mobile-menu__detail"
          href={siteSettings.directionsUrl}
          target="_blank"
          rel="noreferrer"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M19.5 10.5C19.5 17.642 12 21.75 12 21.75S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>{siteSettings.address.formatted}</span>
        </a>
        <p class="mobile-menu__detail">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25A2.25 2.25 0 0 0 21.75 19.5v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>{siteSettings.phone.display}</span>
        </p>
        {
          siteSettings.email && (
            <a class="mobile-menu__detail" href={siteSettings.email.href}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{siteSettings.email.display}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const focusableSelector = [
    'a[href]',
    'button:not([disabled])',
    'summary',
    '[tabindex]:not([tabindex="-1"])',
  ].join(',');

  document
    .querySelectorAll<HTMLElement>('[data-site-header]')
    .forEach((header) => {
      if (header.dataset.initialized === 'true') return;
      header.dataset.initialized = 'true';

      const variant = header.dataset.variant;
      const toggle = header.querySelector<HTMLButtonElement>(
        '[data-mobile-menu-toggle]',
      );
      const panel = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const informationMenu = header.querySelector<HTMLDetailsElement>(
        '[data-information-menu]',
      );
      const desktopNavigationMedia = window.matchMedia('(min-width: 80rem)');
      const backgroundRegions = document.querySelectorAll<HTMLElement>(
        'main, footer, [data-mobile-quick-actions]',
      );
      const initialInertStates = new Map(
        Array.from(backgroundRegions, (region) => [region, region.inert]),
      );
      let menuIsOpen = false;

      const updateScrolledState = () => {
        if (variant === 'transparent') {
          header.dataset.scrolled = window.scrollY > 60 ? 'true' : 'false';
        }
      };

      const setMenuState = (open: boolean, restoreFocus = true) => {
        if (!toggle || !panel) return;
        menuIsOpen = open;
        header.dataset.menuOpen = String(open);
        panel.dataset.open = String(open);
        panel.setAttribute('aria-hidden', String(!open));
        panel.inert = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute(
          'aria-label',
          open ? 'Fermer le menu' : 'Ouvrir le menu',
        );
        if (open) {
          header.setAttribute('role', 'dialog');
          header.setAttribute('aria-modal', 'true');
          header.setAttribute('aria-label', 'Navigation mobile');
        } else {
          header.removeAttribute('role');
          header.removeAttribute('aria-modal');
          header.removeAttribute('aria-label');
        }
        document.body.classList.toggle('mobile-menu-open', open);
        backgroundRegions.forEach((region) => {
          region.inert = open
            ? true
            : (initialInertStates.get(region) ?? false);
        });

        if (open) {
          const firstFocusable =
            panel.querySelector<HTMLElement>(focusableSelector);
          window.requestAnimationFrame(() => firstFocusable?.focus());
        } else if (restoreFocus) {
          toggle.focus();
        }
      };

      updateScrolledState();
      window.addEventListener('scroll', updateScrolledState, {
        passive: true,
      });

      toggle?.addEventListener('click', () => {
        setMenuState(!menuIsOpen);
      });

      panel
        ?.querySelectorAll<HTMLElement>('[data-mobile-menu-link]')
        .forEach((link) => {
          link.addEventListener('click', () => setMenuState(false, false));
        });

      document.addEventListener('keydown', (event) => {
        if (menuIsOpen && event.key === 'Escape') {
          event.preventDefault();
          setMenuState(false);
          return;
        }

        if (menuIsOpen && event.key === 'Tab' && panel) {
          const panelFocusable = Array.from(
            panel.querySelectorAll<HTMLElement>(focusableSelector),
          ).filter((element) => !element.hasAttribute('disabled'));
          const focusable = [
            header.querySelector<HTMLElement>('.site-identity'),
            toggle,
            ...panelFocusable,
          ].filter(
            (element): element is HTMLElement =>
              element instanceof HTMLElement &&
              !element.hasAttribute('disabled'),
          );
          const first = focusable[0];
          const last = focusable.at(-1);

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        }

        if (event.key === 'Escape' && informationMenu?.open) {
          informationMenu.open = false;
          informationMenu.querySelector('summary')?.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (
          informationMenu?.open &&
          event.target instanceof Node &&
          !informationMenu.contains(event.target)
        ) {
          informationMenu.open = false;
        }
      });

      desktopNavigationMedia.addEventListener('change', (event) => {
        if (event.matches && menuIsOpen) {
          setMenuState(false, false);
        }
      });

      const previewMenu =
        window.location.pathname.replace(/\/$/, '') === '/verification' &&
        new URLSearchParams(window.location.search).get('menu') === 'open';
      const previewScrolled =
        window.location.pathname.replace(/\/$/, '') === '/verification' &&
        new URLSearchParams(window.location.search).get('header') ===
          'scrolled';

      if (previewMenu && !desktopNavigationMedia.matches) {
        window.requestAnimationFrame(() => setMenuState(true, false));
      }

      if (previewScrolled) {
        header.dataset.scrolled = 'true';
      }
    });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 60;
    inset: 0 0 auto;
    height: var(--header-height);
    color: var(--color-charcoal);
    transition:
      background-color var(--duration-slow) var(--ease-editorial),
      border-color var(--duration-slow) var(--ease-editorial),
      box-shadow var(--duration-slow) var(--ease-editorial),
      color var(--duration-normal) var(--ease-editorial),
      filter 140ms linear;
  }

  :global(html[data-history-house-lights]) .site-header {
    filter: brightness(var(--history-header-brightness, 1));
  }

  :global(html[data-history-house-lights]) .site-header[data-menu-open='true'] {
    filter: none;
  }

  .site-header[data-variant='light'],
  .site-header[data-scrolled='true'] {
    color: var(--color-ivory);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-gold) 28%, transparent);
    background: rgb(38 29 31 / 78%);
    box-shadow: 0 0.5rem 1.75rem rgb(28 25 24 / 12%);
    -webkit-backdrop-filter: blur(18px) saturate(118%);
    backdrop-filter: blur(18px) saturate(118%);
  }

  .site-header[data-variant='transparent'][data-scrolled='false'] {
    color: var(--color-ivory);
    background: rgb(28 25 24 / 18%);
  }

  .site-header::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: transparent;
    pointer-events: none;
    content: '';
    transition: background-color var(--duration-slow) var(--ease-editorial);
  }

  .site-header[data-variant='transparent'][data-scrolled='false']::before {
    background: linear-gradient(
      to bottom,
      rgb(28 25 24 / 32%),
      rgb(28 25 24 / 14%)
    );
    box-shadow: inset 0 -1px rgb(245 243 238 / 5%);
    -webkit-backdrop-filter: blur(5px) saturate(105%);
    backdrop-filter: blur(5px) saturate(105%);
  }

  .site-header[data-menu-open='true'][data-variant='transparent']::before,
  .site-header[data-menu-open='true']::before {
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-header__container,
  .site-header__inner {
    height: 100%;
  }

  .site-header__container {
    max-width: var(--layout-header);
  }

  .site-header__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-identity {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      filter var(--duration-normal) var(--ease-editorial),
      opacity var(--duration-short) var(--ease-editorial);
  }

  .site-header[data-variant='transparent'][data-scrolled='false']
    .site-identity {
    filter: drop-shadow(0 1px 5px rgb(28 25 24 / 45%));
  }

  .site-identity:hover {
    opacity: 0.9;
  }

  .site-identity :global(.brand-logo) {
    width: 100%;
  }

  .site-header__desktop-nav,
  .site-header__desktop-actions {
    display: none;
  }

  .site-header__mobile-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__menu-button {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__menu-lines {
    display: flex;
    width: 1.25rem;
    height: 1rem;
    flex-direction: column;
    justify-content: space-between;
  }

  .site-header__menu-lines span {
    display: block;
    width: 100%;
    height: 2px;
    transform-origin: center;
    background: currentColor;
    transition:
      translate var(--duration-normal) var(--ease-editorial),
      rotate var(--duration-normal) var(--ease-editorial),
      opacity var(--duration-normal) var(--ease-editorial);
  }

  .site-header[data-menu-open='true'] {
    color: var(--color-ivory);
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-header[data-menu-open='true'] .site-identity {
    filter: drop-shadow(0 1px 5px rgb(28 25 24 / 35%));
  }

  .site-header[data-menu-open='true']
    .site-header__menu-lines
    span:first-child {
    translate: 0 7px;
    rotate: 45deg;
  }

  .site-header[data-menu-open='true']
    .site-header__menu-lines
    span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-menu-open='true'] .site-header__menu-lines span:last-child {
    translate: 0 -7px;
    rotate: -45deg;
  }

  .mobile-menu {
    position: fixed;
    z-index: 1;
    inset: 0;
    visibility: hidden;
    translate: 100% 0;
    background: var(--color-burgundy);
    color: var(--color-ivory);
    transition:
      translate var(--duration-menu) ease-in-out,
      visibility 0s linear var(--duration-menu);
  }

  .mobile-menu[data-open='true'] {
    visibility: visible;
    translate: 0;
    transition:
      translate var(--duration-menu) ease-in-out,
      visibility 0s;
  }

  .mobile-menu__scroll {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(var(--header-height) + 1rem) 2rem
      calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  .mobile-menu__list {
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .mobile-menu__link {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-ivory) 10%, transparent);
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    text-decoration: none;
    transition: color var(--duration-short) var(--ease-editorial);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link[aria-current='page'] {
    color: var(--color-gold);
  }

  .mobile-menu__link[aria-current='page'] {
    font-weight: 600;
  }

  .mobile-menu__details {
    display: grid;
    gap: 1rem;
    margin-top: auto;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
    font-size: var(--font-size-ui);
  }

  .mobile-menu__detail {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    margin: 0;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-short) var(--ease-editorial);
  }

  /* Le téléphone est un `p` : il s'affiche comme les autres coordonnées, mais
     rien ne s'y clique. Seules les lignes réellement navigables réagissent. */
  a.mobile-menu__detail:hover {
    color: var(--color-ivory);
  }

  .mobile-menu__detail svg {
    flex: 0 0 auto;
    color: var(--color-gold);
  }

  @media (min-width: 48rem) {
    .site-identity {
      width: 3.5rem;
      height: 3.5rem;
    }
  }

  @media (min-width: 80rem) {
    .site-header__container {
      padding-inline: var(--gutter-header);
    }
  }

  @media (min-width: 80rem) {
    .site-header__desktop-nav,
    .site-header__desktop-actions {
      display: flex;
      align-items: center;
    }

    .site-header__mobile-actions,
    .mobile-menu {
      display: none;
    }

    .site-header__desktop-list {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-header__nav-link {
      position: relative;
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      gap: 0.25rem;
      padding-inline: 0.75rem;
      border-radius: var(--radius-subtle);
      color: inherit;
      font-size: var(--font-size-ui);
      font-weight: 600;
      letter-spacing: 0.025em;
      text-decoration: none;
      transition: color var(--duration-short) var(--ease-editorial);
    }

    .site-header[data-variant='light'] .site-header__nav-link:hover,
    .site-header[data-scrolled='true'] .site-header__nav-link:hover,
    .site-header[data-variant='light'] .site-header__first-visit:hover,
    .site-header[data-scrolled='true'] .site-header__first-visit:hover {
      color: var(--color-gold);
    }

    .site-header[data-variant='transparent'][data-scrolled='false']
      .site-header__nav-link,
    .site-header[data-variant='transparent'][data-scrolled='false']
      .site-header__first-visit {
      color: var(--color-ivory);
      text-shadow: 0 1px 0.75rem rgb(28 25 24 / 58%);
    }

    .site-header[data-variant='transparent'][data-scrolled='false']
      .site-header__nav-link:hover,
    .site-header[data-variant='transparent'][data-scrolled='false']
      .site-header__first-visit:hover {
      color: var(--color-ivory);
    }

    .site-header__nav-link[aria-current='page']::after,
    .information-menu[data-active='true'] > .information-menu__summary::after {
      position: absolute;
      right: 0.75rem;
      bottom: 0;
      left: 0.75rem;
      height: 1px;
      background: var(--color-gold);
      content: '';
    }

    .site-header__desktop-actions {
      gap: 0.75rem;
    }

    .site-header__first-visit {
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      color: var(--color-muted);
      font-size: var(--font-size-ui);
      font-weight: 600;
      letter-spacing: 0.025em;
      text-decoration: none;
      transition: color var(--duration-short) var(--ease-editorial);
    }

    .site-header[data-variant='light'] .site-header__first-visit,
    .site-header[data-scrolled='true'] .site-header__first-visit {
      color: var(--color-ivory);
    }

    .information-menu {
      position: relative;
    }

    .information-menu__summary {
      cursor: pointer;
      list-style: none;
    }

    .information-menu__summary::-webkit-details-marker {
      display: none;
    }

    .information-menu__summary svg {
      transition: rotate var(--duration-short) var(--ease-editorial);
    }

    .information-menu[open] .information-menu__summary svg {
      rotate: 180deg;
    }

    .information-menu__panel {
      position: absolute;
      top: calc(100% + 0.25rem);
      right: 0;
      width: 13rem;
      margin: 0;
      padding: 0.25rem 0;
      border: 1px solid color-mix(in srgb, var(--color-gold) 20%, transparent);
      background: var(--color-ivory);
      box-shadow: var(--shadow-elevated);
      list-style: none;
    }

    .information-menu__link {
      display: flex;
