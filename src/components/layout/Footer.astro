---
import {
  informationNavigation,
  legalNavigation,
  primaryNavigation,
  scheduleNavigation,
} from '@/lib/navigation';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import { SITE_NAME } from '@/lib/site';
import { getSiteSettings } from '@/lib/content/getSiteSettings';

interface Props {
  variant?: 'default' | 'compact';
}

const { variant = 'default' } = Astro.props;
const currentYear = new Date().getFullYear();
const siteSettings = await getSiteSettings();
---

<footer id="pied-de-page" class="site-footer" data-variant={variant}>
  <div class="site-container">
    <div class="site-footer__grid">
      <div class="site-footer__identity">
        <BrandLogo
          class="site-footer__brand"
          variant="full"
          linked
          loading="lazy"
        />
        <p class="site-footer__statement">
          Un lieu de foi, de paix et de rencontre ouvert à tous, au cœur de
          notre communauté québécoise.
        </p>
        <div class="site-footer__socials" aria-label="Réseaux sociaux">
          <span title="Lien Facebook à confirmer">Facebook</span>
          <span aria-hidden="true">·</span>
          <span title="Lien YouTube à confirmer">YouTube</span>
        </div>
      </div>

      <nav
        class="site-footer__navigation"
        aria-label="Navigation du pied de page"
      >
        <p class="site-footer__heading">Navigation</p>
        <ul class="site-footer__links">
          {
            primaryNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>

        <p class="site-footer__heading site-footer__heading--secondary">
          Informations pratiques
        </p>
        <ul class="site-footer__links">
          {
            informationNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__contact">
        <p class="site-footer__heading">Coordonnées</p>
        <address>
          <p>{siteSettings.address.street}</p>
          <p>
            {siteSettings.address.city}, {siteSettings.address.province}{' '}
            {siteSettings.address.postalCode}
          </p>
          <a href={siteSettings.phone.href}>{siteSettings.phone.display}</a>
          <a href={siteSettings.directionsUrl} target="_blank" rel="noreferrer">
            Obtenir l’itinéraire
          </a>
        </address>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>
        © {currentYear}
        {SITE_NAME}. Tous droits réservés.
      </p>
      <div class="site-footer__legal-links">
        {
          legalNavigation.map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a href={item.href}>{item.label}</a>
            </>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<nav
  class="mobile-quick-actions"
  data-mobile-quick-actions
  aria-label="Actions rapides"
>
  <a href={scheduleNavigation.href}>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>Horaires</span>
  </a>
  <a
    href={siteSettings.phone.href}
    aria-label={`Appeler au ${siteSettings.phone.display}`}
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25A2.25 2.25 0 0 0 21.75 19.5v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>Appeler</span>
  </a>
  <a
    href={siteSettings.directionsUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Obtenir l’itinéraire vers la paroisse"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path
        d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M19.5 10.5C19.5 17.642 12 21.75 12 21.75S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>Itinéraire</span>
  </a>
</nav>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    padding-block: 4rem 2rem;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .site-footer[data-variant='compact'] {
    padding-top: 2rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .site-footer__brand {
    width: clamp(9.5rem, 18vw, 12rem);
    margin-bottom: 1.25rem;
  }

  .site-footer__heading,
  .site-footer__office-label {
    color: var(--color-gold);
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .site-footer__statement {
    max-width: 20rem;
    margin: 0;
    color: color-mix(in srgb, var(--color-ivory) 65%, transparent);
    font-size: var(--font-size-ui);
    line-height: 1.7;
  }

  .site-footer__socials {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    color: color-mix(in srgb, var(--color-ivory) 60%, transparent);
    font-size: var(--font-size-ui);
  }

  .site-footer__heading {
    margin: 0 0 1.25rem;
  }

  .site-footer__heading--secondary {
    margin-top: 2rem;
  }

  .site-footer__links {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__legal a {
    color: color-mix(in srgb, var(--color-ivory) 65%, transparent);
    font-size: var(--font-size-ui);
    text-decoration: none;
    transition: color var(--duration-short) var(--ease-editorial);
  }

  .site-footer__links a:hover,
  .site-footer__legal a:hover {
    color: var(--color-ivory);
  }

  .site-footer__contact address {
    display: grid;
    gap: 0.75rem;
    color: color-mix(in srgb, var(--color-ivory) 65%, transparent);
    font-size: var(--font-size-ui);
    font-style: normal;
    line-height: 1.6;
  }

  .site-footer__contact address a {
    width: fit-content;
    color: inherit;
    text-underline-offset: 0.22em;
    transition: color var(--duration-short) var(--ease-editorial);
  }

  .site-footer__contact address a:hover {
    color: var(--color-ivory);
  }

  .site-footer__contact p {
    margin: 0;
  }

  .site-footer__office {
    padding-top: 0.5rem;
  }

  .site-footer__office-label {
    margin-bottom: 0.5rem !important;
    letter-spacing: 0.15em;
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-ivory) 10%, transparent);
    color: color-mix(in srgb, var(--color-ivory) 60%, transparent);
    font-size: var(--font-size-meta);
  }

  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .site-footer__legal a {
    font-size: inherit;
  }

  .mobile-quick-actions {
    position: fixed;
    z-index: 30;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid
      color-mix(in srgb, var(--color-ivory) 10%, transparent);
    background: color-mix(in srgb, var(--color-charcoal) 95%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .mobile-quick-actions a {
    display: flex;
    min-width: 0;
    min-height: 4.125rem;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    color: var(--color-ivory);
    font-size: var(--font-size-micro);
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: color var(--duration-short) var(--ease-editorial);
  }

  .mobile-quick-actions a:hover {
    color: var(--color-gold);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__legal {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .site-footer__identity {
      grid-column: span 2 / span 2;
    }
  }

  @media (min-width: 80rem) {
    .mobile-quick-actions {
      display: none;
    }
  }
</style>
