    class="lsg-svg"
    viewBox="0 0 500 710"
    role="img"
    aria-label={label}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      {
        fragments.map((fragment, index) => (
          <linearGradient
            id={`lsgF${index}`}
            x1="0"
            y1="0"
            x2="1"
            y2="1"
            gradientTransform={`rotate(${fragment.angle} .5 .5)`}
          >
            <stop offset="0%" stop-color={fragment.colors[0]} />
            <stop offset="46%" stop-color={fragment.colors[1]} />
            <stop offset="100%" stop-color={fragment.colors[2]} />
          </linearGradient>
        ))
      }
      <radialGradient id="lsgHalo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fff6e2" stop-opacity=".72"></stop>
        <stop offset="24%" stop-color="#ffe6ae" stop-opacity=".58"></stop>
        <stop offset="48%" stop-color="#f2b96c" stop-opacity=".34"></stop>
        <stop offset="76%" stop-color="#d98a49" stop-opacity=".13"></stop>
        <stop offset="100%" stop-color="#c2703c" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="lsgCore" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fffaf0" stop-opacity=".95"></stop>
        <stop offset="55%" stop-color="#ffdda2" stop-opacity=".38"></stop>
        <stop offset="100%" stop-color="#eaa757" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="lsgBack" cx="50%" cy="42%" r="66%">
        <stop offset="0%" stop-color="#4f1e2a"></stop>
        <stop offset="100%" stop-color="#33111b"></stop>
      </radialGradient>
      <linearGradient id="lsgSweep" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#fff3d6" stop-opacity="0"></stop>
        <stop offset="42%" stop-color="#fff3d6" stop-opacity=".2"></stop>
        <stop offset="52%" stop-color="#ffffff" stop-opacity=".3"></stop>
        <stop offset="62%" stop-color="#ffe4b0" stop-opacity=".16"></stop>
        <stop offset="100%" stop-color="#ffe4b0" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="lsgStone" x1="0" y1="0" x2=".6" y2="1">
        <stop offset="0%" stop-color="#f1eadd"></stop>
        <stop offset="52%" stop-color="#e9dfca"></stop>
        <stop offset="100%" stop-color="#cdbfa0"></stop>
      </linearGradient>
      <linearGradient id="lsgBrass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e7d0a0"></stop>
        <stop offset="46%" stop-color="#bf9a58"></stop>
        <stop offset="100%" stop-color="#a07e42"></stop>
      </linearGradient>
      <radialGradient id="lsgVig" cx="50%" cy="42%" r="64%">
        <stop offset="52%" stop-color="#3a1119" stop-opacity="0"></stop>
        <stop offset="82%" stop-color="#33101a" stop-opacity=".3"></stop>
        <stop offset="100%" stop-color="#280c14" stop-opacity=".62"></stop>
      </radialGradient>
      <filter id="lsgSoft" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="7"></feGaussianBlur>
      </filter>
      <filter id="lsgBloom" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="16"></feGaussianBlur>
      </filter>
      <clipPath id="lsgClip">
        <path d="M60 700 L60 285 A190 245 0 0 1 440 285 L440 700 Z"></path>
      </clipPath>
    </defs>

    <g class="lsg-stage">
