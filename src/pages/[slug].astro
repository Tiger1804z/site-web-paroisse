---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface PlaceholderPage {
  slug: string;
  title: string;
  description: string;
}

/**
 * Routes réservées : une adresse existe, son contenu n'est pas écrit.
 *
 * Exportée, et déclarée en fonction. Ce n'est pas un détail de style : Astro
 * sort `getStaticPaths()` du frontmatter pour l'appeler pendant le build, et
 * déplace tout le reste du frontmatter DANS le composant. Seuls les `export`
 * demeurent au niveau du module, donc seuls eux sont visibles depuis
 * `getStaticPaths()`. Sans `export`, le build public échoue sur
 * « placeholderPages is not defined ».
 */
export function placeholderPages() {
  return [
    {
      slug: 'galerie',
      title: 'Galerie',
      description:
        'Galerie — route réservée pendant que la sélection photographique demeure intégrée à l’accueil.',
    },
  ] as const satisfies readonly PlaceholderPage[];
}

export function getStaticPaths() {
  return placeholderPages().map((page) => ({
    params: { slug: page.slug },
    props: page,
  }));
}

/**
 * Deux chemins d'arrivée, selon la topologie du build.
 *
 * Site public (`output: 'static'`) : Astro appelle `getStaticPaths()`, connaît
 * la liste des adresses à produire, et passe les données de la page en props.
 * C'est le cas d'aujourd'hui, inchangé.
 *
 * Prévisualisation (`output: 'server'`) : plus rien n'est prérendu, donc
 * `getStaticPaths()` est ignoré — Astro le signale au build. La route devient
 * un attrape-tout : n'importe quel `/quelque-chose/` arrive ici, sans props.
 * Sans la recherche ci-dessous, la page s'afficherait avec un titre vide, et
 * une adresse inexistante répondrait 200 au lieu de 404.
 */
const page =
  (Astro.props as Partial<PlaceholderPage>).slug === undefined
    ? placeholderPages().find((entry) => entry.slug === Astro.params.slug)
    : (Astro.props as PlaceholderPage);

if (!page) {
  return new Response(null, { status: 404 });
}

const { title, description } = page;
---

<BaseLayout seo={{ title, description }} headerVariant="light">
  <section
    class="bg-ivory pt-32 pb-24 md:pt-40 md:pb-32"
    aria-labelledby="placeholder-title"
  >
    <div class="mx-auto max-w-[1280px] px-5 md:px-10 lg:px-20">
      <div class="max-w-[680px]">
        <p
          class="mb-4 text-[0.6875rem] font-semibold tracking-[0.2em] text-muted uppercase"
        >
          Page en préparation
        </p>
        <h1
          id="placeholder-title"
          class="font-display text-[3rem] leading-[1.05] font-semibold text-charcoal md:text-[4.25rem]"
        >
          {title}
        </h1>
        <p class="mt-6 max-w-[38rem] text-lg leading-relaxed text-muted">
          Cette route réserve la structure du futur site. Son contenu complet
          sera migré fidèlement depuis l’export Figma dans un ticket dédié.
        </p>
        <a
          class="mt-10 inline-flex min-h-12 items-center border border-burgundy px-6 py-3 text-sm font-semibold tracking-wide text-burgundy transition-colors duration-200 hover:bg-burgundy hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy"
          href="/"
        >
          Retour à l’accueil
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
