---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" noIndex>
  <section class="error-page" aria-labelledby="error-title">
    <Container size="reading">
      <p class="type-script-accent">404</p>
      <h1 id="error-title" class="type-h1">Cette page semble introuvable</h1>
      <p class="type-body-large">
        La route demandée n’existe pas ou son contenu n’est pas encore
        disponible.
      </p>
      <Button href="/">Retour à l’accueil</Button>
    </Container>
  </section>
</BaseLayout>

<style>
  .error-page {
    padding-block: var(--space-section);
    text-align: center;
  }

  .error-page .type-script-accent {
    margin: 0;
    color: var(--color-gold);
  }

  .error-page h1 {
    margin: 0.5rem 0 0;
    color: var(--color-burgundy);
  }

  .error-page .type-body-large {
    margin: 1.5rem 0 2rem;
    color: var(--color-muted);
  }
</style>
