---
import MotionController from '@/components/motion/MotionController.astro';
import RoomRentalHero from '@/components/sections/room-rental/RoomRentalHero.astro';
import RoomRentalPractical from '@/components/sections/room-rental/RoomRentalPractical.astro';
import RoomRentalRooms from '@/components/sections/room-rental/RoomRentalRooms.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRoomRentalPageData } from '@/lib/content/getRoomRentalPageData';

const roomRentalPageData = await getRoomRentalPageData();
---

<BaseLayout
  seo={roomRentalPageData.seo}
  pageClass="room-rental-page"
  headerVariant="transparent"
>
  <RoomRentalHero hero={roomRentalPageData.hero} />
  <RoomRentalRooms
    offer={roomRentalPageData.offer}
    amenities={roomRentalPageData.amenities}
    rooms={roomRentalPageData.rooms}
  />
  <RoomRentalPractical
    practical={roomRentalPageData.practical}
    finalCta={roomRentalPageData.finalCta}
  />
  <MotionController />
</BaseLayout>
