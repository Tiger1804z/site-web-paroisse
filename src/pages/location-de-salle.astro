---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Location de salle"
  description="La location de salle fait maintenant partie de la page Nos services de la Paroisse Saint-René-Goupil."
  canonicalPath="/nos-services/"
  redirectTo="/nos-services/#location-de-salle"
  headerVariant="light"
  noIndex
>
  <section
    class="bg-ivory pt-32 pb-24 md:pt-40 md:pb-32"
    aria-labelledby="legacy-room-route-title"
  >
    <div class="mx-auto max-w-[1280px] px-5 md:px-10 lg:px-20">
      <div class="max-w-[680px]">
        <p
          class="mb-4 text-[0.75rem] font-semibold tracking-[0.2em] text-wood uppercase"
        >
          Service regroupé
        </p>
        <h1
          id="legacy-room-route-title"
          class="font-display text-[3rem] leading-[1.05] font-semibold text-charcoal md:text-[4.25rem]"
        >
          Location de salle
        </h1>
        <p class="mt-6 max-w-[38rem] text-lg leading-relaxed text-muted">
          Les renseignements prudents sur la disponibilité, la réservation et le
          contrat sont maintenant réunis dans Nos services.
        </p>
        <a
          class="mt-10 inline-flex min-h-12 items-center bg-burgundy px-6 py-3 text-sm font-semibold tracking-wide text-ivory"
          href="/nos-services/#location-de-salle"
        >
          Consulter la location de salle
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
