---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Site paroissial en préparation"
  description="Fondation du futur site Web de la paroisse."
  headerVariant="light"
>
  <section class="technical-home" aria-labelledby="technical-home-title">
    <Container>
      <div class="technical-home__content">
        <Eyebrow>Fondation de production</Eyebrow>
        <h1 id="technical-home-title" class="type-display">
          Le site paroissial<br />prend forme.
        </h1>
        <p class="type-body-large">
          Le design system et le layout global sont en cours de validation. Le
          contenu, les coordonnées et les horaires demeurent temporaires.
        </p>
        <div class="technical-home__actions">
          <Button href="/horaires">Voir les horaires</Button>
          <Button href="/premiere-visite" variant="secondary">
            Première visite
          </Button>
        </div>
      </div>
    </Container>
    <div class="technical-home__motif" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </section>
</BaseLayout>

<style>
  .technical-home {
    position: relative;
    display: flex;
    min-height: calc(100svh - var(--header-height));
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-section);
    background: var(--color-ivory);
  }

  .technical-home__content {
    position: relative;
    z-index: 1;
    max-width: 42.5rem;
  }

  .technical-home h1 {
    margin: 0.75rem 0 0;
    color: var(--color-charcoal);
  }

  .technical-home p.type-body-large {
    max-width: 37.5rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
  }

  .technical-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .technical-home__motif {
    position: absolute;
    top: 0;
    right: -8rem;
    width: min(42rem, 60vw);
    height: min(32rem, 65vh);
    border: 1px solid color-mix(in srgb, var(--color-gold) 12%, transparent);
    border-radius: 0 0 0 100%;
    pointer-events: none;
  }

  .technical-home__motif span {
    position: absolute;
    top: 0;
    right: 25%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-gold) 16%, transparent),
      transparent
    );
  }

  .technical-home__motif span:last-child {
    right: 35%;
  }

  @media (max-width: 30rem) {
    .technical-home__actions :global(.ui-button) {
      width: 100%;
    }
  }
</style>
