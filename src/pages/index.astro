---
import MotionController from '@/components/motion/MotionController.astro';
import HomeGallery from '@/components/sections/home/HomeGallery.astro';
import HomeHero from '@/components/sections/home/HomeHero.astro';
import MassSchedulePreview from '@/components/sections/home/MassSchedulePreview.astro';
import ParishLifePreview from '@/components/sections/home/ParishLifePreview.astro';
import PracticalServices from '@/components/sections/home/PracticalServices.astro';
import SpiritualInterlude from '@/components/sections/home/SpiritualInterlude.astro';
import UpcomingActivitiesSection from '@/components/sections/home/UpcomingActivitiesSection.astro';
import VisitSection from '@/components/sections/home/VisitSection.astro';
import WelcomeSection from '@/components/sections/home/WelcomeSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getHomepageEventsSettings,
  getHomepageParishEvents,
} from '@/lib/content/getParishEvents';
import { getHomePageData } from '@/lib/content/getHomePageData';
import { getSiteSettings } from '@/lib/content/getSiteSettings';
import { getWeeklyMasses } from '@/lib/content/getMassSchedule';

const buildTime = new Date();
const homePage = await getHomePageData();
const homepageEventsSettings = await getHomepageEventsSettings();
const homepageEvents = homepageEventsSettings.showHomepageUpcomingSection
  ? await getHomepageParishEvents(
      buildTime,
      homepageEventsSettings.homepageUpcomingLimit,
    )
  : { secondary: [] };
const siteSettings = await getSiteSettings();
const weeklyMasses = await getWeeklyMasses();
---

<BaseLayout
  title="Accueil"
  titleOrder="site-first"
  description="Découvrez les célébrations, les activités et la vie communautaire de la Paroisse Saint-René-Goupil."
  pageClass="home-page"
  headerVariant="transparent"
>
  <HomeHero content={homePage.hero} masses={weeklyMasses} />
  <WelcomeSection content={homePage.welcome} />
  <MassSchedulePreview content={homePage.massPreview} masses={weeklyMasses} />
  {
    homepageEventsSettings.showHomepageUpcomingSection &&
      homepageEvents.featured && (
        <UpcomingActivitiesSection
          title={homepageEventsSettings.homepageUpcomingTitle}
          events={homepageEvents}
        />
      )
  }
  <ParishLifePreview content={homePage.parishLife} />
  <PracticalServices content={homePage.services} />
  <SpiritualInterlude content={homePage.interlude} />
  {
    homePage.gallery.items.length > 0 && (
      <HomeGallery content={homePage.gallery} />
    )
  }
  <VisitSection content={homePage.visit} contact={siteSettings} />
  <MotionController />
</BaseLayout>
