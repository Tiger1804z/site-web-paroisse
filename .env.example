PUBLIC_SANITY_PROJECT_ID=xo2ahvjo
PUBLIC_SANITY_DATASET=production

# --- Adresse publique du site ---
# Origine seule, sans chemin ni barre oblique finale.
#   SITE_URL=https://exemple.ca
#
# Sert aux adresses canoniques, à l'image de partage et au plan de site, qui
# n'existent qu'en absolu.
#
# Le domaine de la paroisse N'EST PAS ENCORE CHOISI : ne rien inventer ici.
# En développement, l'absence de la variable est sans conséquence — le site
# retombe sur http://localhost:4321. En production, le build ÉCHOUE, ce qui est
# voulu : c'est le moment où quelqu'un doit saisir la vraie adresse dans les
# variables d'environnement de la plateforme d'hébergement.
#
# Un build local de vérification (pnpm validate) peut viser localhost : le build
# le signale alors à voix haute, et sa sortie ne doit pas être déployée.
SITE_URL=

# --- Prévisualisation éditoriale (Presentation / Visual Editing) ---
# Laisser à "false" pour le site public : il reste statique, lit uniquement le
# contenu publié et n'embarque aucun jeton.
# Mettre "true" UNIQUEMENT dans un environnement de prévisualisation.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Adresse du Studio, utilisée pour construire les liens « modifier ce champ ».
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Jeton de lecture des brouillons, à créer dans sanity.io/manage avec les
# permissions Viewer et rien de plus.
# Ne jamais préfixer par PUBLIC_ : c'est ce préfixe, et lui seul, qui décide si
# Astro expose une variable au navigateur.
# Ne jamais committer sa valeur réelle. Requis seulement si la ligne ci-dessus
# vaut "true".
SANITY_API_READ_TOKEN=

# --- Formulaire de contact ---
# Le formulaire poste vers /api/contact, servi par une Cloudflare Pages Function
# (dossier `functions/` à la racine). Les quatre valeurs privées ci-dessous se
# saisissent dans le tableau de bord Pages, JAMAIS ici et JAMAIS dans le code.
#
# Seule la clé Turnstile publique entre dans le HTML : c'est son rôle, elle est
# liée au domaine et sans valeur ailleurs.
#
# Clés de test publiées par Cloudflare, pour développer sans compte :
#   sitekey qui passe toujours : 1x00000000000000000000AA
#   secret  qui accepte toujours : 1x0000000000000000000000000000000AA
#   secret  qui refuse toujours  : 2x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# --- Valeurs privées, pour `wrangler pages dev` uniquement ---
# En production, elles se saisissent côté Cloudflare. Les deux sont des
# SECRETS : ne jamais committer leur valeur réelle.
#
# TURNSTILE_SECRET_KEY=
#
# L'adresse du formulaire Formspree, de la forme
# https://formspree.io/f/xxxxxxxx
#
# Elle DÉSIGNE la boîte du secrétariat : le destinataire est attaché au
# formulaire dans le tableau de bord Formspree, pas transmis par requête.
# Quiconque connaît cette adresse peut y poster directement, sans passer par
# la validation ni par Turnstile — elle se traite donc comme un secret.
#
# C'est ce qui permet au formulaire de fonctionner sans TOUCHER AU DNS :
# Formspree expédie sous sa propre identité, et pose l'adresse du visiteur en
# Reply-To. Il n'y a donc ni expéditeur ni destinataire à configurer ici.
# FORMSPREE_ENDPOINT=

# --- Topologie du build : NE RIEN ÉCRIRE ICI ---
# PREVIEW_DEPLOYMENT décide si le site est compilé en statique (site public) ou
# rendu à la demande derrière l'adaptateur Cloudflare (prévisualisation).
#
# Cette variable est posée par les scripts de build — `scripts/build-public.mjs`
# la force à « false », `scripts/build-preview.mjs` à « true » — et jamais par
# ce fichier.
#
# Pourquoi cette interdiction : mesuré le 18 août 2026, une variable NON
# préfixée `PUBLIC_` écrite dans .env l'emporte sur celle passée par le
# processus. Une ligne oubliée ici décrirait donc une topologie que le build ne
# suit pas. `astro.config.mjs` injecte la valeur qu'il a réellement choisie,
# ce qui neutralise le problème — la consigne reste, elle coûte moins cher
# qu'une exception à expliquer.
