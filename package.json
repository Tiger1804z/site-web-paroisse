{
  "name": "site-web-paroisse",
  "description": "Site Web moderne d’une paroisse catholique francophone au Québec.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:public": "node scripts/build-public.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "check:seo": "node --experimental-strip-types scripts/check-built-seo.mjs",
    "check:public": "node scripts/check-public-bundle.mjs",
    "check:phone": "node scripts/check-parish-phone.mjs",
    "check:preview": "node scripts/check-preview-bundle.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build:public && pnpm check:seo && pnpm check:public && pnpm check:phone",
    "validate:preview": "pnpm build:preview && pnpm check:preview",
    "sanity:typegen": "pnpm --dir studio typegen",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "groq": "^6.6.0",
    "lodash": "4.18.1",
    "react": "^19.2.8",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "^19.2.8",
    "react-is": "19.2.8",
    "sharp": "^0.35.3",
    "styled-components": "^6.4.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.1.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/stega": "1.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "wrangler": "^4.123.0"
  }
}
